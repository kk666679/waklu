<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HalalChain.Platform.Api.CodeGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RazorLight" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.23" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.23" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HalalChain.Platform.Contracts\HalalChain.Platform.Contracts.csproj" />
    <ProjectReference Include="..\HalalChain.Platform.Http\HalalChain.Platform.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Modules\**" />
    <Compile Remove="Persistence\**" />
    <Compile Remove="Services\**" />
    <Compile Remove="Infrastructure\**" />
    <Compile Remove="Migrations\**" />
    <Compile Remove="Controllers\**" />
    <Compile Remove="GlobalUsings.cs" />
    <Compile Remove="Program.cs" />
  </ItemGroup>
</Project>