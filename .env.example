# =============================================================================
# HalalChain — environment variables (TEMPLATE)
# =============================================================================
# This file is a TEMPLATE. Copy to `.env` and replace every value with a real
# secret. Real secrets MUST NEVER be committed to the repository.
#
# Conventions:
#   - ASP.NET services consume `__` (double-underscore) keys
#     (matches ASP.NET Core IConfiguration section binding).
#   - Python services consume `_` (single-underscore) keys
#     (pydantic-settings convention).
#
# All REQUIRED variables below use `VAR:?Set VAR` semantics in docker-compose.yml
# and will fail-fast on `docker compose up` until they are set. The values
# shown here are NON-PRODUCTION PLACEHOLDERS clearly marked as such.
# =============================================================================


# ── ASP.NET platform API (HalalChain.Platform.Api) ──────────────────────────

# JWT signing key. Must be at least 32 characters. The API rejects the
# placeholder value below in non-development environments.
JWT__KEY=REPLACE_ME_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET

# Issuer / audience for issued tokens.
JWT__ISSUER=HalalChainPlatform
JWT__AUDIENCE=HalalChainClients

# ASP.NET Core environment for the .NET services. The dev compose stack
# defaults to Development so `docker compose up` boots cleanly. Production
# deployments MUST set ASPNETCORE_ENVIRONMENT=Production.
ASPNETCORE_ENVIRONMENT=Development

# Postgres connection string. Replace with real credentials in any non-dev
# environment.
POSTGRES_CONNECTION_STRING=Host=postgres;Database=halalchain;Username=halalchain;Password=REPLACE_ME

# Redis connection string. Replace with real credentials in any non-dev
# environment.
REDIS_CONNECTION_STRING=redis:6379

# AI Inference base URL + required API key.
AI_GATEWAY__BASEURL=http://ai-inference:7071
AI_GATEWAY__APIKEY=REPLACE_ME_WITH_32_PLUS_CHAR_RANDOM_SECRET

# Tawheed (evidence + policy engine) base URL.
TAWHEED__BASEURL=http://tawheed:8000

# Comma-separated CORS allow-list for the .NET services. No wildcards.
Cors__AllowedOrigins__0=http://localhost:5001
Cors__AllowedOrigins__1=http://localhost:5200
Cors__AllowedOrigins__2=http://localhost:5201


# ── Docker compose infrastructure ──────────────────────────────────────────

POSTGRES_DB=halalchain
POSTGRES_USER=halalchain
POSTGRES_PASSWORD=REPLACE_ME_WITH_REAL_DB_PASSWORD
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME_WITH_REAL_NEO4J_PASSWORD


# ── Python: ai-inference (.halalchain/ai-inference) ──────────────────────────
PORT=7071
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth — REQUIRED outside dev/demo. ai-inference refuses to start without this.
AI_GATEWAY_API_KEY=REPLACE_ME_WITH_32_PLUS_CHAR_RANDOM_SECRET

# CORS — comma-separated explicit origins. Never "*" with credentials.
AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5200,http://localhost:5201

# Document processing — files outside this directory cannot be read.
AI_INFERENCE_DOCUMENT_ROOT=/var/lib/halalchain/documents

# Cache
ENABLE_CACHE=true
CACHE_STRATEGY=lru            # lru | redis
REDIS_URL=redis://redis:6379/0

# Vector store (Qdrant) — use the Compose service hostname in container-to-
# container calls, NOT localhost.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=halalchain_vectors


# ── Python: tawheed (.halalchain/tawheed) ───────────────────────────────────
ENVIRONMENT=development
DEMO_MODE=true
DEFAULT_JURISDICTION=MY
DEFAULT_POLICY_VERSION=MY-v3

POSTGRES_URL=postgresql+asyncpg://tawheed:REPLACE_ME@postgres:5432/tawheed
REDIS_URL=redis://redis:6379/0

# JWT_SECRET MUST be at least 32 high-entropy characters in non-dev.
JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET

RISK_THRESHOLD_MANUAL_REVIEW=0.65
RISK_THRESHOLD_HOLD=0.85

# IoT device evidence. JSON map of device IDs to HMAC keys; use a secret
# manager in production and rotate keys without committing them.
IOT_ENABLED=false
IOT_DEVICE_KEYS_JSON={}
IOT_MAX_CLOCK_SKEW_SECONDS=300
IOT_OBSERVATION_STORE_PATH=/var/lib/tawheed/evidence/observations.jsonl


# ── AI backend selection (shared by both Python services) ───────────────────
# Canonical values: local | demo | openai | anthropic | foundry | openclaw
#
#   local   — deterministic keyword/rule-based stub (no network). For ai-inference.
#   demo    — no LLM calls; rule-based agents. For tawheed.
#   openai  — OpenAI's hosted API.
#   anthropic — Anthropic's hosted API (or Anthropic-compatible endpoint via
#               ANTHROPIC_BASE_URL, e.g. Ollama / OpenClaw Anthropic mode).
#   foundry — Azure AI Foundry OpenAI-compatible endpoint (production).
#   openclaw — OpenClaw + Ollama gateway (dev / offline / CI). OpenAI-compatible.
#
# The canonical, environment-wide name is AI_BACKEND. The historical aliases
# `LLM_PROVIDER` (tawheed) and `DEFAULT_LLM_PROVIDER` (ai-inference) are
# still accepted for backward compatibility but should be migrated.
AI_BACKEND=local

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=halalchain-assistant

OPENCLAW_BASE_URL=http://host.docker.internal:11434/v1
OPENCLAW_API_KEY=ollama
OPENCLAW_MODEL=halalchain-assistant


# ── Observability Stack ─────────────────────────────────────────────────────

# OpenTelemetry OTLP endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Environment metadata for resource enrichment
ENV=dev
CLUSTER_NAME=local
GIT_SHA=$(git rev-parse --short HEAD)

# AlertManager
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
PAGERDUTY_KEY=xxx
PAGERDUTY_P0_KEY=yyy
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASS=SG.xxx

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Exporters
POSTGRES_DSN=postgresql://halalchain:password@postgres:5432/halalchain?sslmode=disable


# ── MCP server (HalalChain.Mcp) ─────────────────────────────────────────────
# Solution root auto-discovered if HALALCHAIN_SOLUTION_ROOT is not set.
# HALALCHAIN_SOLUTION_ROOT=/path/to/octo-engine

# Service endpoints (defaults shown)
# HALALCHAIN:SERVICES:PLATFORMAPI=http://localhost:5001
# HALALCHAIN:SERVICES:HALALCHAIN=http://localhost:5200
# HALALCHAIN:SERVICES:MARKETPLACE=http://localhost:5201
# HALALCHAIN:SERVICES:TAWHEED=http://localhost:8000
# HALALCHAIN:SERVICES:AIINFERENCE=http://localhost:7071

# MCP runtime tuning
# HALALCHAIN:MCP:MAXREQUESTBYTES=1048576
# HALALCHAIN:MCP:TOOLTIMEOUTSECONDS=30
