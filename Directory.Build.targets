<Project>
  <!--
    Optional: recompile wwwroot/scss/ → wwwroot/css/ during a .NET build.

    This target is OFF by default and must stay that way. The container builds
    compile the stylesheets in a dedicated `node:22-alpine` stage and overlay
    the result (see HalalChain.Web/Dockerfile lines 8-17, 45), because the
    mcr.microsoft.com/dotnet/sdk image used for the `build` stage has no npm.
    Turning this on unconditionally would therefore break `docker build` with
    "npm not found".

    It previously pointed at scripts/build-scss.sh, which does not exist in this
    repository, so the Exists() gate was permanently false and the target was
    dead code that silently never ran. The path is now real, which makes the
    gate meaningful — so opt-in is explicit rather than accidental:

        dotnet build -p:SassEnabled=true

    Requires npm and the root `sass` devDependency on PATH.
  -->
  <PropertyGroup>
    <!-- GetDirectoryName matters: MSBuildThisFileDirectory already ends with a
         backslash, and a trailing backslash inside a quoted argument escapes the
         closing quote, so npm received the path as
         "...\waklu-keewak\"\package.json". GetDirectoryName drops that trailing
         separator. (The [MSBuild]::RemoveTrailingSlash intrinsic is not callable
         as a static method here — it fails with MSB4186.) -->
    <RepoRoot>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileDirectory)'))</RepoRoot>
    <SassBuildScript>$(RepoRoot)/infrastructure/scripts/build-scss.mjs</SassBuildScript>
    <SassEnabled Condition=" '$(SassEnabled)' == '' ">false</SassEnabled>
    <SassEnabled Condition=" '$(SassEnabled)' == 'true' AND Exists('$(SassBuildScript)') AND (Exists('$(MSBuildProjectDirectory)/wwwroot/scss/app.scss') OR Exists('$(MSBuildProjectDirectory)/wwwroot/scss/site.scss')) ">true</SassEnabled>
  </PropertyGroup>

  <Target Name="BuildScss" BeforeTargets="BeforeBuild" Condition="'$(SassEnabled)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <!-- Build the whole stylesheet set from the repository root, because
         build-scss.mjs emits for every UI project, not just this one. -->
    <Exec Command="npm run scss:build --prefix &quot;$(RepoRoot)&quot;" ContinueOnError="false" />
  </Target>

  <!--
    The .NET SDK defaults IntermediateOutputPath and BaseOutputPath to
    Windows-style separators (e.g. "obj\Debug\net10.0") on every platform.
    Most MSBuild tasks tolerate that, but dotnet-watch (Microsoft.DotNet.HotReload.Watch)
    reads IntermediateOutputPath via ProjectTools and combines it with the
    project directory using plain string concatenation. That yields a path such
    as "/repo/HalalChain.Platform.Api/obj\Debug/net10.0/staticwebassets.development.json"
    whose backslashes are treated as literal characters by open(2) on Linux,
    so the file is reported as not found:

        dotnet watch Failed to read '.../obj\Debug/net10.0/staticwebassets.development.json'

    Normalize the output paths to forward separators (and make them absolute,
    rooted at the project directory) so watch, and any other path-sensitive
    consumer, resolves them correctly on Linux. The [MSBuild]::NormalizePath
    function runs Path.GetFullPath internally, collapsing backslashes and any
    "." or ".." segments.
  -->
  <PropertyGroup Condition="'$(IntermediateOutputPath)' != ''">
    <_DotNetWatchNormalizeOutputPaths>true</_DotNetWatchNormalizeOutputPaths>
    <BaseIntermediateOutputPath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)))</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)/$(IntermediateOutputPath)))</IntermediateOutputPath>
    <BaseOutputPath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)/$(BaseOutputPath)))</BaseOutputPath>
    <OutputPath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)/$(OutputPath)))</OutputPath>
  </PropertyGroup>
</Project>
