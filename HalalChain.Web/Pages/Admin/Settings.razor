@page "/admin/settings"
@attribute [Authorize(Roles = "admin")]

<PageTitle>Admin Settings - HalalChain</PageTitle>

<div class="admin-settings">
    <header class="page-header">
        <h1><i class="fas fa-cog"></i> Settings</h1>
        <p class="page-description">Manage platform settings and configuration</p>
    </header>

    <div class="settings-grid">
        <section class="settings-section">
            <h2>General Settings</h2>
            <div class="setting-item">
                <label>Platform Name</label>
                <input type="text" class="form-control" value="HalalChain" />
            </div>
            <div class="setting-item">
                <label>Support Email</label>
                <input type="email" class="form-control" placeholder="support@halalchain.com" />
            </div>
        </section>

        <section class="settings-section">
            <h2>Blockchain Settings</h2>
            <div class="setting-item">
                <label>RPC URL</label>
                <input type="text" class="form-control" readonly />
                <small>Configured via environment variables</small>
            </div>
            <div class="setting-item">
                <label>Chain ID</label>
                <input type="text" class="form-control" readonly />
            </div>
        </section>

        <section class="settings-section">
            <h2>Notification Settings</h2>
            <div class="setting-item checkbox">
                <input type="checkbox" id="emailNotifications" />
                <label for="emailNotifications">Enable email notifications</label>
            </div>
            <div class="setting-item checkbox">
                <input type="checkbox" id="pushNotifications" checked />
                <label for="pushNotifications">Enable push notifications</label>
            </div>
        </section>
    </div>

    <div class="page-actions">
        <button class="btn btn-primary">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <button class="btn btn-secondary">
            <i class="fas fa-undo"></i> Reset
        </button>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
    }
}
