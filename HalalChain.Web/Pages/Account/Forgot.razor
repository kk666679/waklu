@page "/account/forgot"
@inject AppNotificationService Notify

<RadzenCard class="rz-shadow-2" Style="max-width:420px;margin:2rem auto">
    <h3>Reset your password</h3>
    <RadzenTemplateForm TItem="ForgotModel" Data="@_model" Submit="@OnSubmit">
        <RadzenFormField Text="Email"><RadzenTextBox @bind-Value="_model.Email" /></RadzenFormField>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Send reset link" ButtonStyle="ButtonStyle.Primary" Style="width:100%" />
    </RadzenTemplateForm>
</RadzenCard>

@code {
    private ForgotModel _model = new();
    private async Task OnSubmit(ForgotModel _)
    {
        Notify.Info("If an account exists, an email was sent", _model.Email);
    }
    public class ForgotModel { public string Email { get; set; } = ""; }
}
