@page "/account/login"
@inject IAuthService Auth
@inject AppNotificationService Notify
@inject NavigationManager Nav
@inject IHcLocalizer L

<RadzenCard class="rz-shadow-2" Style="max-width:420px;margin:2rem auto">
    <h3>@L.T("auth.signInTo")</h3>
    <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="@OnSubmit">
        <RadzenFormField Text="@L.T("auth.email")"><RadzenTextBox @bind-Value="_model.Email" /></RadzenFormField>
        <RadzenFormField Text="@L.T("auth.password")"><RadzenPassword @bind-Value="_model.Password" /></RadzenFormField>
        <RadzenButton ButtonType="ButtonType.Submit" Text="@L.T("auth.login")" ButtonStyle="ButtonStyle.Primary" Style="width:100%" />
        <div style="margin-top:.5rem">
            <a href="/account/register">@L.T("auth.register")</a> ·
            <a href="/account/forgot">@L.T("auth.forgot")</a>
        </div>
    </RadzenTemplateForm>
</RadzenCard>

@code {
    private LoginModel _model = new();

    private async Task OnSubmit(LoginModel _)
    {
        var r = await Auth.LoginAsync(_model.Email, _model.Password);
        if (r.Success) { Notify.Success(L.T("common.welcome"), _model.Email); Nav.NavigateTo("/"); }
        else Notify.Error(L.T("auth.invalid"), r.Error ?? "");
    }
    public class LoginModel { public string Email { get; set; } = ""; public string Password { get; set; } = ""; }
}
