<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HalalChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Global stylesheet bundle. SCSS sources live in wwwroot/scss/; this
         file is generated by `./scripts/build-scss.sh`. The pre-migration
         _Layout.cshtml declared the cascade reset -> tokens -> ... -> radzen
         in 21 separate <link> tags; that cascade is now preserved inside
         app.css by `app.scss`'s @@use order. The dynamic theme <link> tags
         below remain because runtime theme switching loads theme variants
         independently of the global bundle. -->
    <link rel="stylesheet" href="css/app.css" />

    <link id="radzen-theme-link" rel="stylesheet" href="css/fluent-base.css" />
    <link id="radzen-theme-wcag" rel="stylesheet" href="css/fluent-wcag.css" />

    <base href="~/" />
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') t = 'light';
          var d = t === 'dark';
          document.documentElement.classList.toggle('dark-theme', d);
          document.documentElement.setAttribute('data-theme', t);
        } catch (_) {}
      })();

      // Dynamically load the active Radzen/UI-framework theme variant
      // based on stored preferences. We do NOT bundle every variant
      // because the *-base / *-wcag / *-dark-* files would conflict.
      (function () {
        try {
          var framework = (localStorage.getItem('uiFramework') || 'fluent').toLowerCase();
          var theme = (localStorage.getItem('theme') || 'light').toLowerCase();
          var wcag = localStorage.getItem('wcag') === '1';
          var expressive = localStorage.getItem('materialVariant') === 'expressive';

          var name = framework === 'material3'
            ? (expressive ? 'material3expressive' : 'material3')
            : 'fluent';
          var variant = theme === 'dark' ? '-dark' : '';
          var suffix = wcag ? '-wcag' : '-base';

          var baseHref = 'css/' + name + variant + suffix + '.css';
          var wcagHref = 'css/' + name + variant + '-wcag.css';

          var base = document.getElementById('radzen-theme-link');
          if (base) base.setAttribute('href', baseHref);
          var wcagLink = document.getElementById('radzen-theme-wcag');
          if (wcagLink) wcagLink.setAttribute('href', wcagHref);
        } catch (_) {}
      })();
    </script>
</head>
<body>
    @RenderBody()
    <script src="js/app.js"></script>
    <script src="js/motion.js"></script>
    <script src="js/blazor.server.js"></script>
</body>
</html>
