@page "/vendors/{slug}"
@layout StorefrontLayout
@inject PlatformApiClient Api
@implements IDisposable

<div class="vendor-profile">
    @if (_loading)
    {
        <div class="loading-container">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
            <p>Loading vendor...</p>
        </div>
    }
    else if (_vendor == null)
    {
        <div class="container mt-8 mb-8">
            <div class="card" style="text-align:center;padding:var(--space-12)">
                <i class="fas fa-store fa-3x" style="color:var(--color-neutral-300);margin-bottom:var(--space-4)"></i>
                <h2 class="text-xl font-bold mb-2">Vendor Not Found</h2>
                <p class="text-muted mb-4">The vendor you're looking for doesn't exist.</p>
                <Button Href="/products" Text="Browse Products" Icon="shopping-bag" />
            </div>
        </div>
    }
    else
    {
        <div class="vendor-header-section">
            <div class="container">
                <div class="vendor-header-content">
                    <div class="vendor-avatar">
                        <i class="fas fa-store"></i>
                    </div>
                    <div class="vendor-info">
                        <h1>@_vendor.Name</h1>
                        <div class="vendor-meta">
                            <span><i class="fas fa-map-marker-alt"></i> @_vendor.Country</span>
                            <span><i class="fas fa-circle @(GetStatusClass(_vendor.Status))"></i> @_vendor.Status</span>
                            <span><i class="fas fa-calendar"></i> Joined @_vendor.CreatedAt.ToString("MMMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container mt-8 mb-8">
            <div class="vendor-content-grid">
                <div class="vendor-main">
                    <div class="section-header">
                        <h2>Products by @_vendor.Name</h2>
                        <span class="product-count">@(_products?.Length ?? 0) products</span>
                    </div>

                    @if (_products == null || !_products.Any())
                    {
                        <div class="card" style="text-align:center;padding:var(--space-8)">
                            <i class="fas fa-box-open fa-2x" style="color:var(--color-neutral-300);margin-bottom:var(--space-4)"></i>
                            <p>No products available from this vendor yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-3">
                            @foreach (var product in _products)
                            {
                                <ProductCard Product="product" />
                            }
                        </div>
                    }
                </div>

                <div class="vendor-sidebar">
                    <div class="card">
                        <div class="card-header">About</div>
                        <div class="card-body">
                            <p class="text-muted">
                                @(GetVendorDescription(_vendor.Name))
                            </p>
                        </div>
                    </div>

                    <div class="card mt-6">
                        <div class="card-header">Halal Certification</div>
                        <div class="card-body">
                            <div class="halal-badge-large">
                                <i class="fas fa-certificate"></i>
                                <div>
                                    <strong>Halal Certified Vendor</strong>
                                    <p class="text-sm text-muted">All products are verified by @(_vendor.Country) authorities</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .vendor-profile {
        min-height: 100vh;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 50vh;
        gap: var(--space-4);
        color: var(--color-text-muted);
    }

    .vendor-header-section {
        background: linear-gradient(135deg, var(--color-brand-50) 0%, var(--color-neutral-50) 100%);
        padding: var(--space-12) 0;
    }

    .vendor-header-content {
        display: flex;
        align-items: center;
        gap: var(--space-6);
    }

    .vendor-avatar {
        width: 100px;
        height: 100px;
        border-radius: var(--radius-xl);
        background: var(--color-brand-100);
        color: var(--color-brand-700);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
    }

    .vendor-info h1 {
        font-size: var(--text-2xl);
        font-weight: var(--font-bold);
        margin-bottom: var(--space-2);
    }

    .vendor-meta {
        display: flex;
        gap: var(--space-4);
        color: var(--color-text-secondary);
        font-size: var(--text-sm);
    }

    .vendor-meta span {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .vendor-content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--space-8);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-6);
    }

    .section-header h2 {
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
    }

    .product-count {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }

    .halal-badge-large {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        padding: var(--space-3);
        background: var(--color-success-50);
        border-radius: var(--radius-lg);
    }

    .halal-badge-large i {
        font-size: 1.5rem;
        color: var(--color-success);
    }

    @@media (max-width: 768px) {
        .vendor-content-grid {
            grid-template-columns: 1fr;
        }

        .vendor-header-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

@code {
    [Parameter] public string? Slug { get; set; }

    private VendorDto? _vendor;
    private ProductDto[]? _products;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Slug)) return;

        _loading = true;
        try
        {
            var vendors = await Api.GetVendorsAsync();
            _vendor = vendors.FirstOrDefault(v => v.Slug == Slug || v.Name.ToLower().Replace(" ", "-") == Slug.ToLower());

            if (_vendor != null)
            {
                var allProducts = await Api.GetProductsAsync();
                _products = allProducts.Where(p => p.VendorName == _vendor.Name).ToArray();
            }
        }
        catch { }
        finally
        {
            _loading = false;
        }
    }

    private string GetStatusClass(string? status) => status switch
    {
        "Active" => "text-success",
        "Suspended" => "text-danger",
        _ => "text-warning"
    };

    private string GetVendorDescription(string name) => name switch
    {
        "Pacific Harvest Co." => "Premium halal-certified beverages from Malaysia. Specializing in coconut water and tropical fruit juices.",
        "Al-Falah Foods" => "Leading halal food manufacturer producing premium chicken products and frozen foods.",
        "Heritage Sweets" => "Traditional confectionery from Indonesia, preserving authentic recipes passed down through generations.",
        "Tropical Press" => "Fresh tropical fruit juices, pressed and bottled with no added sugar or preservatives.",
        "Spice Garden MY" => "Authentic Malaysian spice pastes and marinades for traditional cooking.",
        "Golden Harvest" => "Premium quality grains and staples from Pakistan and South Asia.",
        _ => "Verified halal vendor committed to quality and authenticity."
    };

    public void Dispose() { }
}