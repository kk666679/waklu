@using Radzen.Blazor

<div class="filter-rail @(IsOpen ? "filter-rail--open" : "") @AdditionalClass">
    <div class="filter-rail__header">
        <h3 class="filter-rail__title">@Title</h3>
        @if (Clearable)
        {
            <button class="filter-rail__clear" @onclick="ClearAll">
                <RadzenIcon Icon="clear" />
                <span>Clear</span>
            </button>
        }
    </div>
    <div class="filter-rail__body">
        @ChildContent
    </div>
    @if (FooterContent != null)
    {
        <div class="filter-rail__footer">
            @FooterContent
        </div>
    }
    @if (ActiveCount > 0)
    {
        <div class="filter-rail__active-count">
            <RadzenBadge Text="@ActiveCount.ToString()" BadgeStyle="BadgeStyle.Primary" />
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Filters";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public string? AdditionalClass { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    public int ActiveCount { get; private set; }

    public void SetActiveCount(int count) => ActiveCount = count;

    private async Task ClearAll()
    {
        ActiveCount = 0;
        await OnClear.InvokeAsync();
    }
}
