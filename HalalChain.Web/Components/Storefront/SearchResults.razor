@using Radzen.Blazor
@inject NavigationManager Nav
@inject AppState State

<div class="search-results @AdditionalClass">
    <div class="search-results__header">
        <h2 class="search-results__title">
            @if (!string.IsNullOrEmpty(Query))
            {
                <span>Results for "@Query"</span>
            }
            else
            {
                <span>Search Results</span>
            }
        </h2>
        <span class="text-muted">@State.FilteredProducts.Length result@(State.FilteredProducts.Length != 1 ? "s" : "")</span>
    </div>

    @if (State.IsLoading)
    {
        <div class="search-results__skeleton">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else if (!State.FilteredProducts.Any())
    {
        <div class="search-results__empty">
            <RadzenIcon Icon="search_off" Style="font-size:3rem;opacity:0.3" />
            <h3>No results found</h3>
            <p class="text-muted">Try adjusting your search or browse our categories</p>
            <RadzenButton Text="Browse All Products" ButtonStyle="ButtonStyle.Primary" Click="@BrowseAll" />
        </div>
    }
    else
    {
        <div class="search-results__content">
            <div class="search-results__filters">
                <FilterPanel Categories="@State.Categories"
                             HalalStatuses="@GetHalalStatuses()"
                             Departments="@GetDepartments()"
                             OnCategoryChange="@OnCategoryChange"
                             OnHalalStatusChange="@OnHalalStatusChange"
                             OnDepartmentChange="@OnDepartmentChange"
                             OnClearAll="@ClearFilters" />
            </div>
            <div class="search-results__main">
                <div class="search-results__toolbar">
                    <SortDropdown SelectedSort="@_selectedSort" OnSortChanged="@OnSortChanged" />
                    <DataViewToggle ViewMode="@ViewMode" OnViewModeChanged="@OnViewModeChanged" Info="@($"{State.FilteredProducts.Length} products")" />
                </div>
                <div class="search-results__grid @(ViewMode == "list" ? "search-results__grid--list" : "")">
                    @foreach (var p in State.FilteredProducts)
                    {
                        <StorefrontProductCard Product="@GetExtendedProduct(p)" />
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Query { get; set; }
    [Parameter] public string ViewMode { get; set; } = "grid";
    [Parameter] public string? AdditionalClass { get; set; }

    private string _selectedSort = "newest";

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        if (!State.Products.Any())
        {
            await State.LoadProductsAsync();
            await State.LoadCategoriesAsync();
        }
    }

    private async void OnStateChanged() => await InvokeAsync(StateHasChanged);

    private string[] GetHalalStatuses() => ["Verified", "VerifiedByPlatform", "MuslimFriendly", "SelfDeclared"];
    private DepartmentDto[]? GetDepartments() => State.Departments?.Length > 0 ? State.Departments : null;

    private async Task OnCategoryChange(string? cat)
    {
        State.SetCategoryFilter(cat);
    }

    private async Task OnHalalStatusChange(string? status)
    {
        State.SetHalalFilter(status);
    }

    private async Task OnDepartmentChange(string? dept)
    {
        State.SelectedCategory = dept;
        StateHasChanged();
    }

    private async Task OnSortChanged(string? sort)
    {
        _selectedSort = sort ?? "newest";
        StateHasChanged();
    }

    private async Task OnViewModeChanged(string mode)
    {
        ViewMode = mode;
        StateHasChanged();
    }

    private void ClearFilters()
    {
        State.SetSearchQuery("");
        State.SetCategoryFilter(null);
        State.SetHalalFilter(null);
    }

    private void BrowseAll() => Nav.NavigateTo("/products");

    private ExtendedProductDto GetExtendedProduct(ProductDto p) => ExtendedProductDto.FromProductDto(p);

    public void Dispose() => State.OnChange -= OnStateChanged;
}
