@if (!string.IsNullOrEmpty(ImageUrl))
{
    <img src="@ImageUrl" alt="@Alt" class="avatar avatar--@SizeClass @AdditionalClass" />
}
else
{
    <span class="avatar avatar--initials avatar--@SizeClass @AdditionalClass" title="@Alt">@Initials</span>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Medium;
    [Parameter] public string? AdditionalClass { get; set; }

    private string SizeClass => Size switch
    {
        AvatarSize.Small => "sm",
        AvatarSize.Large => "lg",
        _ => "md"
    };

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Text)) return "?";
            var parts = Text.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
            return Text.Length >= 2 ? Text[..2].ToUpper() : Text.ToUpper();
        }
    }

    public enum AvatarSize { Small, Medium, Large }
}
