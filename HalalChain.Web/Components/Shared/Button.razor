@if (Href != null)
{
    <a href="@Href" class="btn @VariantClass @SizeClass @(FullWidth ? "btn-full" : "") @(AdditionalClass ?? "")">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <i class="fas fa-@Icon" aria-hidden="true"></i>
        }
        <span>@Text</span>
    </a>
}
else
{
    <button type="button"
            class="btn @VariantClass @SizeClass @(FullWidth ? "btn-full" : "") @(AdditionalClass ?? "")"
            disabled="@Disabled"
            @onclick="HandleClick">
        @if (Loading)
        {
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <i class="fas fa-@Icon" aria-hidden="true"></i>
        }
        <span>@Text</span>
    </button>
}

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? AdditionalClass { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string VariantClass => Variant switch
    {
        ButtonVariant.Primary => "btn-primary",
        ButtonVariant.Secondary => "btn-secondary",
        ButtonVariant.Ghost => "btn-ghost",
        ButtonVariant.Danger => "btn-danger",
        _ => "btn-primary"
    };

    private string SizeClass => Size switch
    {
        ButtonSize.Small => "btn-sm",
        ButtonSize.Large => "btn-lg",
        _ => ""
    };

    private async Task HandleClick()
    {
        if (Disabled || Loading) return;
        await OnClick.InvokeAsync();
    }

    public enum ButtonVariant { Primary, Secondary, Ghost, Danger }
    public enum ButtonSize { Small, Medium, Large }
}
