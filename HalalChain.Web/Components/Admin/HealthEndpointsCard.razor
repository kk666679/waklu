@if (Endpoints == null || Endpoints.Count == 0)
{
    <p class="text-muted">No health endpoints registered.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Endpoint</th>
                <th>Description</th>
                <th>Services</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ep in Endpoints)
            {
                <tr>
                    <td><code>@ep.Endpoint</code></td>
                    <td>@ep.Description</td>
                    <td>@string.Join(", ", ep.Services)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<HealthEndpointInfo>? Endpoints { get; set; }
    [Parameter] public List<ServiceInfo>? AllServices { get; set; }
}
