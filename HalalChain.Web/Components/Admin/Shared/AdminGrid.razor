@typeparam TItem where TItem : notnull

<RadzenDataGrid @ref="grid" TItem="TItem" Data="@Data" LoadData="@OnLoadData" Count="@Count"
                IsLoading="@IsLoading" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                PageSize="@PageSize" FilterMode="FilterMode.Advanced" Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Right" class="admin-grid rz-shadow-1">
    <Columns>
        @Columns
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public IEnumerable<TItem> Data { get; set; } = Array.Empty<TItem>();
    [Parameter] public int Count { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public RenderFragment Columns { get; set; } = default!;
    [Parameter] public EventCallback<LoadDataArgs> OnLoadData { get; set; }
    private RadzenDataGrid<TItem>? grid;
}
