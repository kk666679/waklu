@using HalalChain.Services
@using HalalChain.Models
@inject IQdrantVectorSearchService VectorSearchService
@inject IJSRuntime JS

<div class="modal @(IsOpen ? "modal-open" : "")" @onclick="OnBackdropClick">
    <div class="modal-content" @onclick:stopPropagation>
        <div class="modal-header">
            <h2>Visual Search</h2>
            <button class="btn-close" @onclick="OnClose">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="modal-body">
            @if (!SearchPerformed)
            {
                <div class="visual-search-setup">
                    <div class="upload-area" @ondrop="OnFileDrop" @ondragover="OnDragOver" @ondragleave="OnDragLeave">
                        <input type="file"
                               accept="image/*"
                               @onchange="OnFileSelected"
                               style="display:none"
                               @ref="FileInput" />
                        
                        <button class="btn btn-primary btn-lg" @onclick="() => FileInput.Value = null; FileInput.Focus()">
                            <i class="fas fa-cloud-upload-alt"></i>
                            Choose Image
                        </button>

                        <p class="upload-text">or drag and drop your image here</p>
                        <p class="upload-hint">JPG, PNG, or WebP • Max 10MB</p>
                    </div>

                    <div class="search-examples">
                        <h4>Example searches:</h4>
                        <div class="example-grid">
                            @foreach (var example in new[] { "Halal Dates", "Organic Honey", "Premium Meat", "Fresh Produce" })
                            {
                                <div class="example-item" @onclick="() => OnExampleSearch(example)">
                                    <span>@example</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (IsSearching)
            {
                <div class="search-progress">
                    <div class="spinner"></div>
                    <p>Searching for similar products...</p>
                </div>
            }
            else if (SearchResults.Any())
            {
                <div class="search-results">
                    <p class="results-count">Found @SearchResults.Count similar products</p>
                    <div class="results-grid">
                        @foreach (var result in SearchResults.Take(12))
                        {
                            <div class="result-card">
                                <img src="@result.Payload.GetValueOrDefault("image_url", "/images/placeholder.svg").ToString()"
                                     alt="@result.Payload.GetValueOrDefault("name", "Product").ToString()"
                                     class="result-image" />
                                <div class="result-info">
                                    <h4>@result.Payload.GetValueOrDefault("name", "Unknown")</h4>
                                    <p class="similarity">@($"{result.Similarity:P0} match")</p>
                                    <button class="btn btn-primary btn-sm" @onclick="() => OnViewProduct(result)">
                                        View Product
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="no-results">
                    <i class="fas fa-search fa-3x"></i>
                    <p>No results found. Try another image.</p>
                    <button class="btn btn-secondary" @onclick="ResetSearch">
                        Search Again
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.2s ease;
}

.modal.modal-open {
    display: flex;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-content {
    background: white;
    border-radius: 12px;
    width: 90%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    animation: slideUp 0.3s ease;
}

@keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--color-neutral-200);
}

.modal-header h2 {
    margin: 0;
    font-size: 20px;
}

.btn-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    color: var(--color-neutral-400);
}

.btn-close:hover {
    color: var(--color-neutral-900);
}

.modal-body {
    padding: 32px 20px;
}

.visual-search-setup {
    text-align: center;
}

.upload-area {
    border: 2px dashed var(--color-primary-300);
    border-radius: 8px;
    padding: 40px 20px;
    background: var(--color-primary-50);
    margin-bottom: 32px;
    transition: all 0.2s ease;
}

.upload-area.dragover {
    border-color: var(--color-primary-500);
    background: var(--color-primary-100);
}

.upload-text {
    margin: 16px 0 8px 0;
    font-size: 14px;
    color: var(--color-neutral-600);
}

.upload-hint {
    margin: 0;
    font-size: 12px;
    color: var(--color-neutral-500);
}

.search-examples h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 12px;
    text-align: left;
}

.example-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.example-item {
    padding: 12px 16px;
    border: 1px solid var(--color-neutral-200);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    font-size: 13px;
}

.example-item:hover {
    border-color: var(--color-primary-500);
    background: var(--color-primary-50);
    color: var(--color-primary-700);
}

.search-progress {
    text-align: center;
    padding: 40px;
}

.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--color-neutral-200);
    border-top-color: var(--color-primary-500);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 20px;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.search-results {
    text-align: center;
}

.results-count {
    font-size: 14px;
    color: var(--color-neutral-600);
    margin-bottom: 16px;
}

.results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
}

.result-card {
    background: white;
    border: 1px solid var(--color-neutral-200);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
}

.result-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.result-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--color-neutral-100);
}

.result-info {
    padding: 12px;
}

.result-info h4 {
    font-size: 12px;
    margin: 0 0 4px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.similarity {
    font-size: 11px;
    color: var(--color-primary-600);
    margin: 4px 0;
}

.no-results {
    text-align: center;
    padding: 40px;
    color: var(--color-neutral-500);
}

.no-results i {
    color: var(--color-neutral-300);
    margin-bottom: 16px;
}

.no-results p {
    margin: 16px 0;
}
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    [Parameter]
    public EventCallback<SimilarProductResult> OnProductSelected { get; set; }

    private bool SearchPerformed = false;
    private bool IsSearching = false;
    private List<SimilarProductResult> SearchResults = new();
    private ElementReference FileInput;
    private bool IsDragOver = false;

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        var files = (await JS.InvokeAsync<dynamic>("getFileList", e)).files;
        if (files.length > 0)
        {
            await PerformVisualSearch();
        }
    }

    private async Task OnFileDrop(DragEventArgs e)
    {
        IsDragOver = false;
        // Handle dropped files
        if (e.DataTransfer.Files.Length > 0)
        {
            await PerformVisualSearch();
        }
    }

    private void OnDragOver(DragEventArgs e)
    {
        e.DataTransfer.DropEffect = "copy";
        IsDragOver = true;
    }

    private void OnDragLeave(DragEventArgs e)
    {
        IsDragOver = false;
    }

    private async Task PerformVisualSearch()
    {
        try
        {
            SearchPerformed = true;
            IsSearching = true;

            // Simulate visual search via vector database
            var results = await VectorSearchService.SearchSimilarAsync("uploaded_image", 12);
            SearchResults = results;
        }
        catch (Exception ex)
        {
            // Log error
        }
        finally
        {
            IsSearching = false;
        }
    }

    private async Task OnExampleSearch(string example)
    {
        try
        {
            SearchPerformed = true;
            IsSearching = true;

            var results = await VectorSearchService.SearchSimilarAsync(example, 12);
            SearchResults = results;
        }
        catch
        {
            // Handle error
        }
        finally
        {
            IsSearching = false;
        }
    }

    private void ResetSearch()
    {
        SearchPerformed = false;
        SearchResults.Clear();
    }

    private async Task OnViewProduct(SimilarProductResult result)
    {
        await OnProductSelected.InvokeAsync(result);
        await OnClose();
    }

    private async Task OnBackdropClick()
    {
        await OnClose();
    }

    private async Task OnClose()
    {
        ResetSearch();
        await OnClosed.InvokeAsync();
    }
}
