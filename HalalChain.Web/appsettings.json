{
  "Jwt": {
    "Issuer": "HalalChainPlatform",
    "Audience": "HalalChainClients",
    "Key": "",
    "ExpiresMinutes": 60
  },
  "PlatformApi": {
    "BaseUrl": "http://localhost:5001/"
  },
  "Api": {
    "BaseUrl": "http://localhost:5001/"
  },
  "FeatureFlags": {
    "Flags": {
      "services.wishlist.api_backed": { "enabled": false, "rolloutPercent": 0 },
      "services.cart.api_backed": { "enabled": false, "rolloutPercent": 0 },
      "services.cart.merge_enabled": { "enabled": true, "rolloutPercent": 100 }
    }
  },
  "Qdrant": {
    "Url": "http://localhost:6333",
    "ApiKey": null,
    "Enabled": true
  },
  "Search": {
    "IndexingEnabled": true,
    "SemanticSearchEnabled": true,
    "VectorStoreProvider": "Qdrant"
  },
  "Catalog": {
    "BulkImportMaxRows": 10000,
    "EnableVariants": true,
    "EnableSustainability": true,
    "EnableDynamicPricing": true
  },
  "Inventory": {
    "ReservationExpiryMinutes": 15,
    "LowStockThreshold": 5,
    "EnableRealTimeSync": true,
    "ForecastDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
