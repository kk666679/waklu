{
  "title": "Platform Overview",
  "uid": "platform-overview",
  "tags": ["halalchain", "sre"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "env", "type": "custom", "query": "prod,staging,dev", "current": { "value": "prod" } },
      { "name": "service", "type": "query", "datasource": "Prometheus", "query": "label_values(up, service)" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Global Error Budget Remaining (30d)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "slo:error_budget_remaining:30d",
        "legendFormat": "remaining"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.75 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (service) (rate(http_server_request_duration_seconds_count{env=\"$env\"}[5m]))",
        "legendFormat": "{{ service }}"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Ratio by Service",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (service) (rate(http_server_request_duration_seconds_count{env=\"$env\",http_response_status_code=~\"5..\"}[5m])) / sum by (service) (rate(http_server_request_duration_seconds_count{env=\"$env\"}[5m]))",
        "legendFormat": "{{ service }}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "P95 Latency by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
        "legendFormat": "{{ service }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Business KPIs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "biz:orders_created:rate1h * 3600", "legendFormat": "Orders/hr" },
        { "expr": "biz:verifications_completed:rate1h * 3600", "legendFormat": "Verifications/hr" },
        { "expr": "biz:gmv:rate1h * 3600", "legendFormat": "GMV/hr ($)" }
      ]
    },
    {
      "id": 6,
      "type": "nodeGraph",
      "title": "Service Topology (from Tempo service graphs)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": "Tempo",
      "targets": [{
        "queryType": "serviceMap",
        "serviceMapQuery": "{}"
      }]
    }
  ]
}