{
  "title": "AI Inference SLO",
  "uid": "ai-inference-slo",
  "tags": ["halalchain", "slo", "ai-inference"],
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (endpoint) (rate(ai_inference_requests_total[5m]))",
        "legendFormat": "{{ endpoint }}"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Rate by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (endpoint) (rate(ai_inference_requests_total{status=~\"5..\"}[5m])) / sum by (endpoint) (rate(ai_inference_requests_total[5m]))",
        "legendFormat": "{{ endpoint }}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM Latency P95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(ai_inference_request_duration_seconds_bucket{endpoint=~\"/llm.*\"}[5m])))",
        "legendFormat": "{{ endpoint }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU Memory Pressure",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "nvidia_gpu_memory_used_bytes / nvidia_gpu_memory_total_bytes"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.9 }] }
        }
      }
    }
  ]
}