{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TawheedRequest",
  "description": "Input to POST /tawheed/evaluate. The only request shape the sealed boundary accepts. Anything not described here is ignored, not interpreted.",
  "type": "object",
  "required": ["tenant_id", "subject", "evidence_ids", "policy_version", "evaluated_at"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must match the caller's tenant. A mismatch is refused before evaluation."
    },
    "subject": {
      "type": "object",
      "description": "What is being evaluated. Supplies the product/facility/batch/shipment fields the rules read.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["product", "facility", "batch", "shipment", "certificate", "participant", "application"]
        },
        "id": { "type": "string", "minLength": 1 },
        "product": { "$ref": "#/$defs/product" },
        "facility": { "$ref": "#/$defs/facility" },
        "batch": { "$ref": "#/$defs/batch" },
        "shipment": { "$ref": "#/$defs/shipment" },
        "certificate": { "$ref": "#/$defs/certificate" },
        "jurisdiction": { "type": "string" }
      },
      "required": ["type", "id"],
      "additionalProperties": true
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Every referenced item must be in state >= verified. Evidence below that is a precondition failure, not a rule violation."
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Resolved from policies/core.yaml plus the applicable jurisdiction and scheme overrides. An unrecognised version produces decision=error, never a permissive default."
    },
    "scheme": {
      "type": "string",
      "description": "Certification scheme identifier, e.g. MS-1500. Absent means the tenant's default scheme."
    },
    "jurisdiction": {
      "type": "string",
      "description": "Two-letter code, e.g. MY. Overrides subject.jurisdiction when both are present; a mismatch is a precondition failure."
    },
    "actor": { "$ref": "#/$defs/actor" },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Supplied by the caller, not read from the engine clock. This is what makes the call reproducible: replaying a request with the same evaluated_at yields the same response."
    },
    "correlation_id": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "product": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "cold_chain_class": { "type": "string", "enum": ["frozen", "chilled", "ambient"] }
      },
      "additionalProperties": true
    },
    "facility": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jurisdiction": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "batch": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ingredient_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredient_id": { "type": "string" },
              "supplier_participant_id": { "type": "string" }
            },
            "required": ["ingredient_id", "supplier_participant_id"],
            "additionalProperties": true
          }
        }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "shipment": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "product": { "$ref": "#/$defs/product" }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "certificate": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "scope": {
          "type": "object",
          "properties": {
            "product_categories": { "type": "array", "items": { "type": "string" } },
            "facility_ids": { "type": "array", "items": { "type": "string" } },
            "sku_list": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Empty or absent means every SKU at every listed facility. A malformed scope fails closed - it is not a wildcard."
            },
            "jurisdiction": { "type": "string" }
          },
          "required": ["product_categories", "facility_ids", "jurisdiction"],
          "additionalProperties": false
        }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "description": "The acting participant. Optional in the schema but required at runtime: without it, delegated-authority-check cannot evaluate and the request is refused.",
      "properties": {
        "participant_id": { "type": "string" },
        "role": { "type": "string" },
        "type": { "type": "string" },
        "own_capabilities": { "type": "array", "items": { "type": "string" } },
        "tenant_id": { "type": "string" }
      },
      "required": ["participant_id", "role", "type"],
      "additionalProperties": true
    }
  }
}
