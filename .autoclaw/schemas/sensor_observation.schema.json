{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halalchain/schemas/sensor_observation.schema.json",
  "title": "SensorObservation",
  "description": "Signed, normalized device telemetry used as compliance evidence. This object never carries a halal verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "productId", "deviceId", "observedAt", "metric", "value", "unit", "readingHash", "signature"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "productId": {"type": "string", "format": "uuid"},
    "deviceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "observedAt": {"type": "string", "format": "date-time"},
    "metric": {"enum": ["temperature", "humidity", "location"]},
    "value": {"type": "number", "finite": true},
    "unit": {"enum": ["celsius", "percent", "latitude_longitude"]},
    "readingHash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
    "signature": {"type": "string", "minLength": 1},
    "receivedAt": {"type": "string", "format": "date-time"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"metric": {"const": "location"}}},
      "then": {"required": ["location"]}
    }
  ]
}
