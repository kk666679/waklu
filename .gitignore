# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# ─── .NET ────────────────────────────────────────────────────────────────────
**/bin/
**/obj/
*.user
*.suo
.vs/

# The CLI's bin/ is source, not build output: package.json declares
# "bin": {"halalchain": "./bin/halalchain.js"} and `files` ships it, so the
# **/bin/ rule above silently excluded the published entry point from git.
!HalalChain-Cli/bin/

# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Python ─────────────────────────────────────────────────────────────────
# The .halalchain/* services are FastAPI apps, so running any of them (or
# check-docs.py) drops __pycache__ next to the source. Without these rules the
# compiled .pyc files get committed.
__pycache__/
*.py[cod]

# ─── Local runtime state ─────────────────────────────────────────────────────
.data/
*.ndjson
HalalChain.Platform.Api/.aspnet/
HalalChain-Cli/sandbox/
*.css.map
.kiro/*
.kilo/*
.autoclaw/*
!.autoclaw/MANIFEST.yaml
!.autoclaw/PRINCIPLES.md
!.autoclaw/CONTROLS.yaml
!.autoclaw/agents/
!.autoclaw/agents/**
!.autoclaw/anchors/
!.autoclaw/anchors/**
!.autoclaw/byok/
!.autoclaw/byok/**
!.autoclaw/compliance/
!.autoclaw/compliance/**
!.autoclaw/governance/
!.autoclaw/governance/**
!.autoclaw/mcp/
!.autoclaw/mcp/**
!.autoclaw/observability/
!.autoclaw/observability/redaction.yaml
!.autoclaw/security/
!.autoclaw/security/secrets/
!.autoclaw/security/secrets/**
!.autoclaw/skills/
!.autoclaw/skills/published/
!.autoclaw/skills/published/**
!.autoclaw/tawheed/
!.autoclaw/tawheed/**
!.autoclaw/tenants/
!.autoclaw/tenants/**

# ─── Alertmanager secrets ────────────────────────────────────────────────────
# Written by infrastructure/scripts/write-alertmanager-secrets.py from the
# repo-root .env. These are live credentials (Slack webhook, PagerDuty routing
# keys, SMTP password) and must never be committed.
infrastructure/alertmanager/secrets/*
!infrastructure/alertmanager/secrets/.gitignore

.run/
.aspnet/
halalchain.db
