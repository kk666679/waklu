{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halalchain.dev/schemas/gate.schema.json",
  "title": "Phase Gate",
  "type": "object",
  "required": ["id", "from", "to", "criteria_file", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^gate-[0-9]{3}-[0-9]{3}(-final)?$" },
    "from": { "type": "string", "pattern": "^ENT-[0-9]{3}$" },
    "to": { "type": ["string", "null"], "pattern": "^ENT-[0-9]{3}$" },
    "criteria_file": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "automated", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+\\.[0-9]+$" },
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "automated": {
            "type": "boolean",
            "description": "false means a human must judge; the gate script must report PENDING, never PASS"
          },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
