<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    HalalChain.Domain references NOTHING.

    No Entity Framework, no ASP.NET, no JSON serializers, no logging.
    If a type here needs one of those, the type is in the wrong project.

    Enforced by HalalChain.Architecture.Tests.
  -->

</Project>
