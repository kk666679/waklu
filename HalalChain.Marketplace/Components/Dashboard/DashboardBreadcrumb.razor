@using HalalChain.Marketplace.Services.Dashboard
@inject INavigationService NavigationService
@inject ITenantContext TenantContext
@inject NavigationManager Navigation
@inject ILogger<DashboardBreadcrumb> Logger

<nav class="dashboard-breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
        @if (Breadcrumbs?.Count > 0)
        {
            @foreach (var breadcrumb in Breadcrumbs.OrderBy(x => x.Order))
            {
                <li class="breadcrumb-item">
                    @if (breadcrumb.IsCurrent)
                    {
                        <span class="breadcrumb-current" aria-current="page">
                            @if (!string.IsNullOrEmpty(breadcrumb.IconClass))
                            {
                                <i class="@breadcrumb.IconClass" aria-hidden="true"></i>
                            }
                            @breadcrumb.Label
                        </span>
                    }
                    else if (!string.IsNullOrEmpty(breadcrumb.Href))
                    {
                        <a href="@breadcrumb.Href" class="breadcrumb-link">
                            @if (!string.IsNullOrEmpty(breadcrumb.IconClass))
                            {
                                <i class="@breadcrumb.IconClass" aria-hidden="true"></i>
                            }
                            @breadcrumb.Label
                        </a>
                        <span class="breadcrumb-separator" aria-hidden="true">/</span>
                    }
                </li>
            }
        }
    </ol>
</nav>

@code {
    [Parameter]
    public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    [Parameter]
    public string? CurrentPath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // If breadcrumbs not provided, build them from current path
            if ((Breadcrumbs?.Count ?? 0) == 0 && !string.IsNullOrEmpty(CurrentPath))
            {
                Breadcrumbs = await NavigationService.GetBreadcrumbsAsync(
                    TenantContext, 
                    CurrentPath);

                Logger.LogInformation(
                    "Breadcrumbs built for path {Path}: {BreadcrumbCount} items",
                    CurrentPath, Breadcrumbs.Count);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error building breadcrumbs");
        }
    }
}
