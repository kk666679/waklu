@inherits LayoutComponentBase
@inject IJSRuntime JS

<!--
    ============================================================================
    ADMIN LAYOUT — Enhanced 2026
    
    Provides the main shell for all admin pages:
    - Dark-first topbar with logo, search, quick actions
    - Responsive sidebar with navigation
    - Main content area with @Body
    - Integrated theme system using hcTheme.js
    - Keyboard shortcut support (Ctrl+K for search)
    - WCAG 2.2 AA accessibility
    ============================================================================
-->

<div class="admin-shell" data-theme="dark">
    <!-- Topbar: Logo, Search, Actions -->
    <header class="admin-topbar" role="banner">
        <div class="admin-topbar__left">
            <button class="btn-sidebar-toggle" @onclick="ToggleSidebar" aria-label="Toggle navigation" aria-expanded="@_sidebarOpen">
                ☰
            </button>
            <a href="/admin" class="admin-brand" title="Back to admin home">
                <span class="admin-brand-mark">◈</span>
                <span class="admin-brand-text">
                    <span class="admin-brand-name">HalalChain</span>
                    <span class="admin-brand-sub">Admin</span>
                </span>
            </a>
        </div>

        <div class="admin-topbar__center">
            <div class="cmd-search" role="search">
                🔍
                <input type="search"
                       placeholder="Search… (Ctrl+K)"
                       @onkeydown="HandleSearchKeyDown"
                       aria-label="Search admin" />
                <kbd>⌘K</kbd>
            </div>
        </div>

        <div class="admin-topbar__right">
            <a href="/vendor" class="btn-ghost" title="Vendor Portal">
                🏢 <span class="hide-sm">Vendor</span>
            </a>
            <a href="/" class="btn-ghost" title="Back to Storefront">
                🛍 <span class="hide-sm">Store</span>
            </a>
            <button class="btn-ghost" @onclick="ToggleTheme" aria-label="Toggle theme" title="Toggle dark/light mode">
                <span id="theme-icon">🌙</span>
            </button>
        </div>
    </header>

    <div class="admin-body">
        <!-- Sidebar Navigation -->
        <nav class="admin-sidebar @(_sidebarOpen ? "" : "collapsed")" aria-label="Admin navigation">
            <ul class="nav-list">
                <li>
                    <a href="/admin" class="nav-link" title="Dashboard">
                        <span class="nav-icon">📊</span>
                        <span class="nav-label">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/vendors" class="nav-link" title="Vendor Management">
                        <span class="nav-icon">🏢</span>
                        <span class="nav-label">Vendors</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/products" class="nav-link" title="Product Catalog">
                        <span class="nav-icon">📦</span>
                        <span class="nav-label">Products</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/certificates" class="nav-link" title="Certificate Management">
                        <span class="nav-icon">🏆</span>
                        <span class="nav-label">Certificates</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/agents" class="nav-link" title="Agent Workflows">
                        <span class="nav-icon">🤖</span>
                        <span class="nav-label">Agents</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/audit" class="nav-link" title="Audit Log">
                        <span class="nav-icon">📋</span>
                        <span class="nav-label">Audit</span>
                    </a>
                </li>
                <li class="nav-divider" role="separator"></li>
                <li>
                    <a href="/admin/settings" class="nav-link" title="Settings">
                        <span class="nav-icon">⚙️</span>
                        <span class="nav-label">Settings</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="admin-main" role="main" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize theme system
            await JS.InvokeVoidAsync("hcTheme.onThemeChange", (object)new Action<string>(OnThemeChanged));
            await UpdateThemeIcon();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("hcTheme.toggle");
        await UpdateThemeIcon();
    }

    private async Task UpdateThemeIcon()
    {
        var currentTheme = await JS.InvokeAsync<string>("hcTheme.current");
        var icon = currentTheme == "dark" ? "☀️" : "🌙";
        await JS.InvokeVoidAsync("eval", $"document.getElementById('theme-icon').textContent = '{icon}'");
    }

    private void OnThemeChanged(string theme)
    {
        // Trigger re-render if needed
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Search would be handled by the page-level component
            // This is just to prevent form submission
        }
    }
}
