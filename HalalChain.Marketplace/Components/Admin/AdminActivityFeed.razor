@* AdminActivityFeed.razor - Real-time activity feed for marketplace events *@

@using HalalChain.Marketplace.Models

<div class="activity-feed">
    <div class="activity-header">
        <h3>Recent Activity</h3>
        <button class="btn-icon" @onclick="RefreshActivity" aria-label="Refresh activity feed">
            🔄
        </button>
    </div>

    @if (!Events.Any())
    {
        <div class="activity-empty">
            <p class="text-muted">No recent activity</p>
        </div>
    }
    else
    {
        <div class="activity-list" role="feed" aria-label="Recent marketplace events">
            @foreach (var item in Events)
            {
                <div class="activity-item" role="article" aria-label="@item.Title: @item.Subject at @item.At.ToString("g")">
                    <div class="activity-icon" aria-hidden="true">
                        @GetEventIcon(item.Category)
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">
                            <strong>@item.Title</strong>
                            <span class="activity-time">@FormatRelativeTime(item.At)</span>
                        </div>
                        <p class="activity-subject">@item.Subject</p>
                        @if (!string.IsNullOrEmpty(item.Category))
                        {
                            <span class="activity-badge">@item.Category</span>
                        }
                    </div>
                    <button class="btn-icon-sm" @onclick="() => OnEventClick(item)" aria-label="View details for @item.Title">
                        →
                    </button>
                </div>
            }
        </div>
    }

    @if (Events.Length > 5)
    {
        <div class="activity-footer">
            <button class="btn-link" @onclick="ViewAllActivity" aria-label="View all activity">
                View all events →
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public required ActivityEvent[] Events { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback<ActivityEvent> OnEventClicked { get; set; }

    private async Task RefreshActivity()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task OnEventClick(ActivityEvent item)
    {
        await OnEventClicked.InvokeAsync(item);
    }

    private async Task ViewAllActivity()
    {
        // Navigate to detailed activity log
        // await Nav.NavigateTo("/admin/activity");
    }

    private string FormatRelativeTime(DateTimeOffset dateTime)
    {
        var now = DateTimeOffset.UtcNow;
        var delta = now - dateTime;

        if (delta.TotalSeconds < 60)
            return "just now";
        if (delta.TotalMinutes < 60)
            return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24)
            return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays < 7)
            return $"{(int)delta.TotalDays}d ago";

        return dateTime.ToString("MMM d, yyyy");
    }

    private string GetEventIcon(string? category) => category switch
    {
        "certificate" => "🏆",
        "verification" => "✅",
        "vendor" => "🏢",
        "product" => "📦",
        "policy" => "⚖️",
        "error" => "⚠️",
        "warning" => "⚡",
        _ => "•"
    };
}
