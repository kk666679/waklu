@* AdminVendorDrawer.razor - Side panel for detailed vendor inspection *@

@using HalalChain.Platform.Contracts.Vendors.Dto

@if (Vendor != null)
{
    var facilities = Vendor.Facilities ?? [];

    <div class="drawer-overlay" @onclick="OnClose" aria-hidden="true"></div>
    <aside class="drawer drawer-right" role="complementary" aria-label="Vendor details">
        <div class="drawer-header">
            <h2>@Vendor.Name</h2>
            <button class="btn-icon-close" @onclick="OnClose" aria-label="Close vendor details">
                ✕
            </button>
        </div>

        <div class="drawer-content">
            <!-- Vendor Overview Section -->
            <section class="drawer-section" aria-labelledby="vendor-overview-heading">
                <h3 id="vendor-overview-heading" class="section-heading">Overview</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="detail-value">
                            <span class="badge @(IsActive(Vendor.Status) ? "badge-success" : "badge-warning")">
                                @StatusLabel(Vendor.Status)
                            </span>
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Country</span>
                        <span class="detail-value">@(Vendor.Country ?? "—")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">
                            @if (string.IsNullOrEmpty(Vendor.Email))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <a href="mailto:@Vendor.Email" class="link">@Vendor.Email</a>
                            }
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Phone</span>
                        <span class="detail-value">
                            @if (string.IsNullOrEmpty(Vendor.Phone))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <a href="tel:@Vendor.Phone" class="link">@Vendor.Phone</a>
                            }
                        </span>
                    </div>
                </div>
            </section>

            <!-- Facilities Section -->
            @if (facilities.Length > 0)
            {
                <section class="drawer-section" aria-labelledby="facilities-heading">
                    <h3 id="facilities-heading" class="section-heading">Facilities</h3>
                    <div class="detail-grid">
                        @foreach (var facility in facilities)
                        {
                            <div class="detail-item">
                                <span class="detail-label">@facility.Name</span>
                                <span class="detail-value">
                                    @facility.City@(string.IsNullOrEmpty(facility.Country) ? "" : $", {facility.Country}")
                                </span>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- Address Section -->
            @if (!string.IsNullOrEmpty(Vendor.Address))
            {
                <section class="drawer-section" aria-labelledby="address-heading">
                    <h3 id="address-heading" class="section-heading">Address</h3>
                    <address class="detail-value">@Vendor.Address</address>
                </section>
            }

            <!-- Timeline Section -->
            <section class="drawer-section" aria-labelledby="timeline-heading">
                <h3 id="timeline-heading" class="section-heading">Timeline</h3>
                <div class="timeline">
                    @if (Vendor.CreatedAt != default)
                    {
                        <div class="timeline-item">
                            <span class="timeline-dot"></span>
                            <div class="timeline-content">
                                <p class="text-sm text-muted">Registered</p>
                                <time>@Vendor.CreatedAt.ToString("MMM d, yyyy")</time>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Actions Section -->
            <section class="drawer-section drawer-actions" aria-labelledby="actions-heading">
                <h3 id="actions-heading" class="section-heading sr-only">Actions</h3>
                <button class="btn btn-primary btn-block" @onclick="() => ViewProducts(Vendor)">
                    View Products
                </button>
                @if (!IsActive(Vendor.Status))
                {
                    <button class="btn btn-success btn-block" @onclick="() => ApproveVendor(Vendor)">
                        Approve Vendor
                    </button>
                }
                <button class="btn btn-secondary btn-block" @onclick="OnClose">
                    Close
                </button>
            </section>
        </div>
    </aside>
}

@code {
    [Parameter]
    public VendorDto? Vendor { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<VendorDto> OnViewProducts { get; set; }

    [Parameter]
    public EventCallback<VendorDto> OnApprove { get; set; }

    private static bool IsActive(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);

    private static string StatusLabel(string? status) =>
        string.IsNullOrWhiteSpace(status) ? "Unknown" : status;

    private async Task ViewProducts(VendorDto vendor)
    {
        await OnViewProducts.InvokeAsync(vendor);
    }

    private async Task ApproveVendor(VendorDto vendor)
    {
        await OnApprove.InvokeAsync(vendor);
        await OnClose.InvokeAsync();
    }
}
