@page "/tenant/{TenantId}/dashboard/vendor"
@attribute [Authorize(Roles = "Vendor")]
@inject IDashboardConfigService ConfigService
@inject INavigationService NavigationService
@inject ITenantContext TenantContext
@inject IPlatformApiClient Api
@inject ICurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@inject ILogger<VendorDashboard> Logger

@using HalalChain.Marketplace.Models.Dashboard
@using HalalChain.Marketplace.Components.Admin

<PageTitle>@PageTitle — HalalChain</PageTitle>

<DashboardLayout PageTitle="@PageTitle" BreadcrumbItems="BreadcrumbItems">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="page-loading" role="status" aria-live="polite">
                <div class="loading-spinner"></div>
                <p>Loading vendor dashboard…</p>
            </div>
        }
        else if (ErrorMessage is not null)
        {
            <div class="dashboard-error" role="alert">
                <p>@ErrorMessage</p>
            </div>
        }
        else
        {
            <div class="vendor-dashboard-content">
                <section class="dashboard-section">
                    <h2>Your Store Overview</h2>
                    <div class="vendor-overview-card">
                        <div class="overview-header">
                            <h3>@VendorName</h3>
                            <span class="compliance-badge" style="background-color: @GetComplianceBadgeColor()">
                                Compliance: @ComplianceScore%
                            </span>
                        </div>
                        <p class="overview-description">@VendorDescription</p>
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Performance Metrics</h2>
                    <div class="metrics-grid">
                        <MetricCard Label="Total Sales" Value="@OrderCount" Icon="package" Accent="success" />
                        <MetricCard Label="Active Products" Value="@Products.Count" Icon="package" Accent="primary" />
                        <MetricCard Label="Pending Orders" Value="@PendingOrderCount" Icon="grid" Accent="warning" />
                        <MetricCard Label="Shipped Orders" Value="@ShippedOrderCount" Icon="shield-check" Accent="primary" />
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Recent Orders</h2>
                    <div class="orders-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (RecentOrders.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5">No orders yet</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var order in RecentOrders)
                                    {
                                        <tr>
                                            <td>@order.OrderId</td>
                                            <td>@order.Currency @order.Amount.ToString("N2")</td>
                                            <td>
                                                <span class="status-badge @GetOrderStatusClass(order.Status)">@order.Status</span>
                                            </td>
                                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <button class="action-link" @onclick="() => HandleViewOrderAsync(order)">
                                                    View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Product Inventory</h2>
                    <div class="inventory-grid">
                        @if (Products.Count == 0)
                        {
                            <p>No products yet. Add your first product to get started.</p>
                        }
                        else
                        {
                            @foreach (var product in Products)
                            {
                                <div class="inventory-card">
                                    <div class="product-info">
                                        <h4>@product.Name</h4>
                                        <p class="product-sku">SKU: @product.Sku</p>
                                    </div>
                                    <div class="stock-info">
                                        <span class="stock-level">Stock: @product.StockLevel</span>
                                        <div class="stock-bar">
                                            <div class="stock-bar-fill" style="width: @product.StockPercentage.ToString("F0")%"></div>
                                        </div>
                                    </div>
                                    <div class="product-actions">
                                        <button @onclick="() => HandleEditProductAsync(product)">Edit</button>
                                        <button @onclick="() => HandleViewAnalyticsAsync(product)">Analytics</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="dashboard-section quick-actions">
                    <h2>Quick Actions</h2>
                    <div class="actions-grid">
                        <button class="action-btn" @onclick="HandleAddProductAsync">
                            <i class="icon-plus" aria-hidden="true"></i>
                            <span>Add Product</span>
                        </button>
                        <button class="action-btn" @onclick="HandleManageInventoryAsync">
                            <i class="icon-inventory" aria-hidden="true"></i>
                            <span>Manage Inventory</span>
                        </button>
                        <button class="action-btn" @onclick="HandleViewReportsAsync">
                            <i class="icon-report" aria-hidden="true"></i>
                            <span>View Reports</span>
                        </button>
                        <button class="action-btn" @onclick="HandleContactSupportAsync">
                            <i class="icon-help" aria-hidden="true"></i>
                            <span>Contact Support</span>
                        </button>
                    </div>
                </section>
            </div>
        }
    </ChildContent>
</DashboardLayout>

@code {
    [Parameter]
    public string? TenantId { get; set; }

    private const string PageTitle = "Vendor Dashboard";

    private List<BreadcrumbItem> BreadcrumbItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private string VendorName { get; set; } = "Your Store";
    private string VendorDescription { get; set; } = "Premium halal products and services";
    private int ComplianceScore { get; set; } = 96;

    private IReadOnlyList<VendorOrderRow> RecentOrders { get; set; } = [];
    private IReadOnlyList<VendorInventoryRow> Products { get; set; } = [];

    private int OrderCount => RecentOrders.Count;
    private int PendingOrderCount => RecentOrders.Count(o => IsStatus(o.Status, "pending", "processing"));
    private int ShippedOrderCount => RecentOrders.Count(o => IsStatus(o.Status, "shipped", "out for delivery"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation(
                "Initializing vendor dashboard for tenant {TenantId}",
                TenantContext.TenantId);

            BreadcrumbItems = await NavigationService.GetBreadcrumbsAsync(
                TenantContext,
                $"/tenant/{TenantContext.TenantId}/dashboard/vendor");

            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing vendor dashboard");
            ErrorMessage = "Failed to load the vendor dashboard. Please refresh the page.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        var vendorId = CurrentUser.UserId;
        var vendorName = VendorName;

        if (vendorId is not null)
        {
            var vendorResult = await Api.GetVendorByIdAsync(vendorId.Value);
            if (vendorResult.IsSuccess && vendorResult.Data is { } vendor)
            {
                vendorName = vendor.Name;
            }
        }

        var ordersTask = Api.GetOrdersAsync();
        var productsTask = Api.GetProductsAsync(pageSize: 100);

        await Task.WhenAll(ordersTask, productsTask);

        VendorName = vendorName;
        RecentOrders = ProjectOrders(ordersTask.Result);
        Products = ProjectInventory(productsTask.Result);
    }

    private static IReadOnlyList<VendorOrderRow> ProjectOrders(ApiResult<OrderDto[]> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            return [];
        }

        return result.Data
            .SelectMany(order => order.VendorOrders.Select(vendorOrder => new VendorOrderRow(
                $"{order.Id.ToString("N")[..8].ToUpperInvariant()}-{vendorOrder.Id.ToString("N")[..4].ToUpperInvariant()}",
                vendorOrder.VendorName,
                vendorOrder.Subtotal,
                vendorOrder.Currency,
                vendorOrder.Status,
                order.CreatedAt)))
            .OrderByDescending(o => o.OrderDate)
            .ToList();
    }

    private static IReadOnlyList<VendorInventoryRow> ProjectInventory(ApiResult<ProductDto[]> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            return [];
        }

        return result.Data
            .Select(p => new VendorInventoryRow(p.Id, p.Title, p.Slug, p.Inventory, Math.Max(p.Inventory, 100)))
            .ToList();
    }

    private static bool IsStatus(string status, params string[] candidates)
        => candidates.Contains(status, StringComparer.OrdinalIgnoreCase);

    private void HandleViewOrderAsync(VendorOrderRow order)
        => Logger.LogInformation("View order: {OrderId}", order.OrderId);

    private void HandleEditProductAsync(VendorInventoryRow product)
        => Nav.NavigateTo($"/vendor/products/{product.Id}/edit");

    private void HandleViewAnalyticsAsync(VendorInventoryRow product)
        => Nav.NavigateTo("/vendor/analytics");

    private void HandleAddProductAsync() => Nav.NavigateTo("/vendor/products/new");

    private void HandleManageInventoryAsync() => Nav.NavigateTo("/vendor/products");

    private void HandleViewReportsAsync() => Nav.NavigateTo("/vendor/analytics");

    private void HandleContactSupportAsync() => Nav.NavigateTo("/account");

    private string GetComplianceBadgeColor()
        => ComplianceScore >= 95 ? "#10B981" : ComplianceScore >= 85 ? "#F59E0B" : "#EF4444";

    private static string GetOrderStatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "delivered" => "status-delivered",
            "processing" => "status-processing",
            "shipped" => "status-shipped",
            _ => "status-pending"
        };
}
