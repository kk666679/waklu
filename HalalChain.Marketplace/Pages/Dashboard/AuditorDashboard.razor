@page "/tenant/{TenantId}/dashboard/auditor"
@attribute [Authorize(Roles = "Auditor")]
@inject IDashboardConfigService ConfigService
@inject INavigationService NavigationService
@inject ITenantContext TenantContext
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject ILogger<AuditorDashboard> Logger

@using HalalChain.Marketplace.Models.Dashboard
@using HalalChain.Marketplace.Components.Admin

<PageTitle>@PageTitle — HalalChain</PageTitle>

<DashboardLayout PageTitle="@PageTitle" BreadcrumbItems="BreadcrumbItems">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="page-loading" role="status" aria-live="polite">
                <div class="loading-spinner"></div>
                <p>Loading auditor dashboard…</p>
            </div>
        }
        else if (ErrorMessage is not null)
        {
            <div class="dashboard-error" role="alert">
                <p>@ErrorMessage</p>
            </div>
        }
        else
        {
            <div class="auditor-dashboard-content">
                <section class="dashboard-section">
                    <h2>Audit Summary</h2>
                    <div class="summary-grid">
                        <MetricCard Label="Audits Pending" Value="@PendingAuditsList.Count" Icon="grid" Accent="warning" />
                        <MetricCard Label="Vendors Monitored" Value="@AuditedVendorCount" Icon="building" Accent="success" />
                        <MetricCard Label="High Risk Vendors" Value="@HighRiskVendors.Count" Icon="shield-check" Accent="error" />
                        <MetricCard Label="Evidence Items" Value="@EvidenceItems.Count" Icon="package" Accent="primary" />
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Compliance Risk Assessment</h2>
                    <div class="risk-matrix">
                        <div class="risk-category high-risk">
                            <h4>High Risk</h4>
                            <p class="risk-count">@HighRiskVendors.Count</p>
                            <div class="vendor-list">
                                @foreach (var vendor in HighRiskVendors)
                                {
                                    <div class="risk-vendor" @onclick="() => HandleAuditVendorAsync(vendor)">
                                        <span class="vendor-name">@vendor.Name</span>
                                        <span class="compliance-score">@vendor.ComplianceScore%</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="risk-category medium-risk">
                            <h4>Medium Risk</h4>
                            <p class="risk-count">@MediumRiskVendors.Count</p>
                            <div class="vendor-list">
                                @foreach (var vendor in MediumRiskVendors)
                                {
                                    <div class="risk-vendor" @onclick="() => HandleAuditVendorAsync(vendor)">
                                        <span class="vendor-name">@vendor.Name</span>
                                        <span class="compliance-score">@vendor.ComplianceScore%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Audit Queue</h2>
                    <div class="audit-queue-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Vendor</th>
                                    <th>Type</th>
                                    <th>Priority</th>
                                    <th>Assigned To</th>
                                    <th>Status</th>
                                    <th>Due Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (PendingAuditsList.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7">No audits pending</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var audit in PendingAuditsList)
                                    {
                                        <tr>
                                            <td>@audit.VendorName</td>
                                            <td>@audit.AuditType</td>
                                            <td><span class="priority-badge @audit.PriorityClass">@audit.Priority</span></td>
                                            <td>@audit.AssignedTo</td>
                                            <td>@audit.Status</td>
                                            <td>@audit.DueDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <button class="action-link" @onclick="() => HandleStartAuditAsync(audit)">
                                                    Start
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Evidence Repository</h2>
                    <div class="evidence-filters">
                        <input type="text" placeholder="Search evidence…" class="search-input" aria-label="Search evidence" />
                        <button class="btn-primary" @onclick="HandleUploadEvidenceAsync">Upload Evidence</button>
                    </div>
                    <div class="evidence-grid">
                        @if (EvidenceItems.Count == 0)
                        {
                            <p>No evidence items recorded yet.</p>
                        }
                        else
                        {
                            @foreach (var evidence in EvidenceItems)
                            {
                                <div class="evidence-card">
                                    <div class="evidence-header">
                                        <h4>@evidence.Title</h4>
                                        <span class="category-badge">@evidence.Category</span>
                                    </div>
                                    <p class="evidence-description">@evidence.Description</p>
                                    <div class="evidence-meta">
                                        <small>Uploaded: @evidence.UploadedDate.ToString("MMM dd, yyyy")</small>
                                        <small>By: @evidence.UploadedBy</small>
                                    </div>
                                    <div class="evidence-actions">
                                        <button @onclick="() => HandleViewEvidenceAsync(evidence)">View</button>
                                        <button @onclick="() => HandleDownloadEvidenceAsync(evidence)">Download</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="dashboard-section auditor-actions">
                    <h2>Auditor Tools</h2>
                    <div class="actions-grid">
                        <button class="action-btn" @onclick="HandleGenerateReportAsync">
                            <i class="icon-report" aria-hidden="true"></i>
                            <span>Generate Report</span>
                        </button>
                        <button class="action-btn" @onclick="HandleScheduleAuditAsync">
                            <i class="icon-calendar" aria-hidden="true"></i>
                            <span>Schedule Audit</span>
                        </button>
                        <button class="action-btn" @onclick="HandleReviewComplianceAsync">
                            <i class="icon-check" aria-hidden="true"></i>
                            <span>Review Compliance</span>
                        </button>
                        <button class="action-btn" @onclick="HandleExportDataAsync">
                            <i class="icon-download" aria-hidden="true"></i>
                            <span>Export Data</span>
                        </button>
                    </div>
                </section>
            </div>
        }
    </ChildContent>
</DashboardLayout>

@code {
    [Parameter]
    public string? TenantId { get; set; }

    private const string PageTitle = "Auditor Dashboard";

    private List<BreadcrumbItem> BreadcrumbItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private int AuditedVendorCount { get; set; }
    private IReadOnlyList<RiskVendorRow> HighRiskVendors { get; set; } = [];
    private IReadOnlyList<RiskVendorRow> MediumRiskVendors { get; set; } = [];
    private IReadOnlyList<AuditQueueRow> PendingAuditsList { get; set; } = [];
    private IReadOnlyList<EvidenceRow> EvidenceItems { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation(
                "Initializing auditor dashboard for tenant {TenantId}",
                TenantContext.TenantId);

            BreadcrumbItems = await NavigationService.GetBreadcrumbsAsync(
                TenantContext,
                $"/tenant/{TenantContext.TenantId}/dashboard/auditor");

            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing auditor dashboard");
            ErrorMessage = "Failed to load the auditor dashboard. Please refresh the page.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        var vendorsTask = Api.GetVendorsAsync();
        var productsTask = Api.GetProductsAsync(pageSize: 100);

        await Task.WhenAll(vendorsTask, productsTask);

        var vendors = vendorsTask.Result.IsSuccess ? vendorsTask.Result.Data ?? [] : [];
        var products = productsTask.Result.IsSuccess ? productsTask.Result.Data ?? [] : [];

        AuditedVendorCount = vendors.Length;

        // Risk banding is derived from catalog verification state only. It is a
        // review queue for an authorized auditor, not a compliance decision —
        // authoritative status stays with tawheed and the certification body (P2).
        var risk = vendors
            .Select(v => new RiskVendorRow(
                v.Name,
                string.Equals(v.Status, "Active", StringComparison.OrdinalIgnoreCase) ? 100 : 50))
            .OrderBy(v => v.ComplianceScore)
            .ToList();

        HighRiskVendors = risk.Where(v => v.ComplianceScore < 60).ToList();
        MediumRiskVendors = risk.Where(v => v.ComplianceScore is >= 60 and < 90).ToList();

        PendingAuditsList = vendors
            .Take(10)
            .Select((v, index) => new AuditQueueRow(
                v.Name,
                index % 3 == 0 ? "Annual" : "Compliance Check",
                index % 3 == 0 ? "High" : "Medium",
                "Unassigned",
                "Scheduled",
                DateTimeOffset.UtcNow.AddDays(index + 1)))
            .ToList();

        EvidenceItems = products
            .Select(p => new EvidenceRow(
                $"{p.Title} ({p.HalalStatus?.Status ?? "Unknown"})",
                p.HalalStatus?.Status ?? "Unknown",
                p.Description ?? "No description supplied.",
                p.CreatedAt,
                p.VendorName))
            .ToList();
    }

    private void HandleAuditVendorAsync(RiskVendorRow vendor)
        => Logger.LogInformation("Audit vendor selected: {VendorName}", vendor.Name);

    private void HandleStartAuditAsync(AuditQueueRow audit)
        => Logger.LogInformation("Start audit for vendor: {VendorName}", audit.VendorName);

    private void HandleViewEvidenceAsync(EvidenceRow evidence)
        => Logger.LogInformation("View evidence: {Title}", evidence.Title);

    private void HandleDownloadEvidenceAsync(EvidenceRow evidence)
        => Logger.LogInformation("Download evidence: {Title}", evidence.Title);

    private void HandleUploadEvidenceAsync() => Nav.NavigateTo("/vendor/products");

    private void HandleGenerateReportAsync() => Nav.NavigateTo("/verify");

    private void HandleScheduleAuditAsync() => Nav.NavigateTo("/verify");

    private void HandleReviewComplianceAsync() => Nav.NavigateTo("/verify");

    private void HandleExportDataAsync() => Nav.NavigateTo("/verify");
}
