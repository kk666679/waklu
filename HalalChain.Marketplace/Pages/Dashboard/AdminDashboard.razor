@page "/tenant/{TenantId}/dashboard/admin"
@attribute [Authorize(Roles = "Administrator")]
@implements IAsyncDisposable
@inject IDashboardConfigService ConfigService
@inject INavigationService NavigationService
@inject ITenantContext TenantContext
@inject ILogger<AdminDashboard> Logger

<DashboardLayout PageTitle="@PageTitle" BreadcrumbItems="BreadcrumbItems">
    <!-- Page Content using shared layout -->
    @if (IsLoading)
    {
        <div class="page-loading">
            <div class="loading-spinner"></div>
            <p>Loading admin dashboard...</p>
        </div>
    }
    else
    {
        <!-- Admin-specific widgets and content -->
        <div class="admin-dashboard-content">
            <!-- Key Metrics Row -->
            <section class="dashboard-section">
                <h2>Platform Overview</h2>
                <div class="metrics-grid">
                    <MetricCard Title="Total Vendors" 
                               Value="@VendorCount.ToString()" 
                               Icon="icon-building"
                               TrendPercent="@VendorTrend"
                               Color="primary" />
                    
                    <MetricCard Title="Active Products" 
                               Value="@ProductCount.ToString()" 
                               Icon="icon-package"
                               TrendPercent="@ProductTrend"
                               Color="success" />
                    
                    <MetricCard Title="Orders (24h)" 
                               Value="@OrderCount.ToString()" 
                               Icon="icon-shopping-cart"
                               TrendPercent="@OrderTrend"
                               Color="info" />
                    
                    <MetricCard Title="Compliance Score" 
                               Value="@ComplianceScore.ToString(\"F1\") + \"%\"" 
                               Icon="icon-shield"
                               TrendPercent="@ComplianceTrend"
                               Color="warning" />
                </div>
            </section>

            <!-- Admin Vendor Grid -->
            <section class="dashboard-section">
                <h2>Vendor Management</h2>
                <AdminVendorGrid Vendors="@Vendors" 
                                OnVendorSelected="HandleVendorSelectedAsync"
                                OnRefresh="RefreshVendorsAsync" />
            </section>

            <!-- Product Compliance Status -->
            <section class="dashboard-section">
                <h2>Product Compliance Status</h2>
                <AdminProductGrid Products="@Products" 
                                  OnProductSelected="HandleProductSelectedAsync"
                                  OnRefresh="RefreshProductsAsync" />
            </section>

            <!-- Activity Feed -->
            <section class="dashboard-section">
                <h2>Recent Activity</h2>
                <AdminActivityFeed Activities="@ActivityEvents" 
                                  OnRefresh="RefreshActivityAsync" />
            </section>

            <!-- Admin Actions Panel -->
            <section class="dashboard-section admin-actions">
                <h2>Administrator Actions</h2>
                <div class="actions-grid">
                    <button class="action-btn" @onclick="HandleOnboardVendorAsync">
                        <i class="icon-plus" aria-hidden="true"></i>
                        <span>Onboard Vendor</span>
                    </button>
                    <button class="action-btn" @onclick="HandleAuditLogsAsync">
                        <i class="icon-log" aria-hidden="true"></i>
                        <span>View Audit Logs</span>
                    </button>
                    <button class="action-btn" @onclick="HandleComplianceReportAsync">
                        <i class="icon-report" aria-hidden="true"></i>
                        <span>Generate Report</span>
                    </button>
                    <button class="action-btn" @onclick="HandleSystemSettingsAsync">
                        <i class="icon-settings" aria-hidden="true"></i>
                        <span>System Settings</span>
                    </button>
                </div>
            </section>
        </div>
    }
</DashboardLayout>

@code {
    [Parameter]
    public string? TenantId { get; set; }

    private string PageTitle { get; set; } = "Administrator Dashboard";
    private List<BreadcrumbItem> BreadcrumbItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;

    // Metrics
    private int VendorCount { get; set; }
    private int ProductCount { get; set; }
    private int OrderCount { get; set; }
    private double ComplianceScore { get; set; }
    private double VendorTrend { get; set; }
    private double ProductTrend { get; set; }
    private double OrderTrend { get; set; }
    private double ComplianceTrend { get; set; }

    // Data collections
    private List<VendorDto> Vendors { get; set; } = new();
    private List<ProductDto> Products { get; set; } = new();
    private List<ActivityEvent> ActivityEvents { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation(
                "Initializing admin dashboard for tenant {TenantId}",
                TenantContext.TenantId);

            // Build breadcrumbs
            BreadcrumbItems = await NavigationService.GetBreadcrumbsAsync(
                TenantContext,
                $"/tenant/{TenantContext.TenantId}/dashboard/admin");

            // Load dashboard data
            await LoadDashboardDataAsync();

            IsLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing admin dashboard");
            IsLoading = false;
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            // Load metrics
            await Task.WhenAll(
                LoadMetricsAsync(),
                LoadVendorsAsync(),
                LoadProductsAsync(),
                LoadActivityAsync()
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dashboard data");
        }
    }

