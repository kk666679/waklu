            new ActivityEvent { Timestamp = DateTime.UtcNow.AddMinutes(-15), Actor = "System", Action = "Compliance check passed", Type = "Compliance" },
            new ActivityEvent { Timestamp = DateTime.UtcNow.AddHours(-1), Actor = "Admin User", Action = "Added new product", Type = "Product" }
        };
        
        await Task.Delay(300);
    }

    private async Task RefreshVendorsAsync()
    {
        Logger.LogInformation("Refreshing vendors");
        await LoadVendorsAsync();
    }

    private async Task RefreshProductsAsync()
    {
        Logger.LogInformation("Refreshing products");
        await LoadProductsAsync();
    }

    private async Task RefreshActivityAsync()
    {
        Logger.LogInformation("Refreshing activity");
        await LoadActivityAsync();
    }

    private async Task HandleVendorSelectedAsync(VendorDto vendor)
    {
        Logger.LogInformation("Vendor selected: {VendorId}", vendor.Id);
        // TODO: Navigate to vendor detail page
        await Task.CompletedTask;
    }

    private async Task HandleProductSelectedAsync(ProductDto product)
    {
        Logger.LogInformation("Product selected: {ProductId}", product.Id);
        // TODO: Navigate to product detail page
        await Task.CompletedTask;
    }

    private async Task HandleOnboardVendorAsync()
    {
        Logger.LogInformation("Onboard vendor action triggered");
        // TODO: Open vendor onboarding modal
        await Task.CompletedTask;
    }

    private async Task HandleAuditLogsAsync()
    {
        Logger.LogInformation("View audit logs action triggered");
        // TODO: Navigate to audit logs page
        await Task.CompletedTask;
    }

    private async Task HandleComplianceReportAsync()
    {
        Logger.LogInformation("Generate compliance report action triggered");
        // TODO: Generate and download report
        await Task.CompletedTask;
    }

    private async Task HandleSystemSettingsAsync()
    {
        Logger.LogInformation("System settings action triggered");
        // TODO: Navigate to system settings page
        await Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await ValueTask.CompletedTask;
    }

    // DTOs for sample data
    public class VendorDto
    {
        public string Id { get; set; } = null!;
        public string Name { get; set; } = null!;
        public string Status { get; set; } = null!;
        public int ComplianceScore { get; set; }
    }

    public class ProductDto
    {
        public string Id { get; set; } = null!;
        public string Name { get; set; } = null!;
        public string Vendor { get; set; } = null!;
        public string Status { get; set; } = null!;
        public string ComplianceLevel { get; set; } = null!;
    }

    public class ActivityEvent
    {
        public DateTime Timestamp { get; set; }
        public string Actor { get; set; } = null!;
        public string Action { get; set; } = null!;
