        VendorTrend = 12.5;
        ProductCount = 1240;
        ProductTrend = 8.3;
        OrderCount = 392;
        OrderTrend = -2.1;
        ComplianceScore = 94.6;
        ComplianceTrend = 1.2;
        
        await Task.Delay(300); // Simulate API call
    }

