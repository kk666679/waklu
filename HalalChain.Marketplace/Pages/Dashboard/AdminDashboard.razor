@page "/tenant/{TenantId}/dashboard/admin"
@attribute [Authorize(Roles = "Administrator")]
@inject IDashboardConfigService ConfigService
@inject INavigationService NavigationService
@inject ITenantContext TenantContext
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject ILogger<AdminDashboard> Logger

@using HalalChain.Marketplace.Models
@using HalalChain.Marketplace.Models.Dashboard
@using HalalChain.Marketplace.Components.Admin

<PageTitle>@PageTitle — HalalChain</PageTitle>

<DashboardLayout PageTitle="@PageTitle" BreadcrumbItems="BreadcrumbItems">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="page-loading" role="status" aria-live="polite">
                <div class="loading-spinner"></div>
                <p>Loading admin dashboard…</p>
            </div>
        }
        else if (ErrorMessage is not null)
        {
            <div class="dashboard-error" role="alert">
                <p>@ErrorMessage</p>
            </div>
        }
        else
        {
            <div class="admin-dashboard-content">
                <section class="dashboard-section">
                    <h2>Platform Overview</h2>
                    <div class="metrics-grid">
                        <MetricCard Label="Total Vendors" Value="@VendorCount" Icon="building" Accent="primary" />
                        <MetricCard Label="Active Products" Value="@ProductCount" Icon="package" Accent="success" />
                        <MetricCard Label="Orders (24h)" Value="@OrderCount" Icon="package" Accent="primary" />
                        <MetricCard Label="Categories" Value="@CategoryCount" Icon="grid" Accent="warning" />
                    </div>
                </section>

                <section class="dashboard-section">
                    <h2>Vendor Management</h2>
                    <AdminVendorGrid Vendors="@Vendors" OnRowSelected="HandleVendorSelectedAsync" />
                </section>

                <section class="dashboard-section">
                    <h2>Product Compliance Status</h2>
                    <AdminProductGrid Products="@Products" OnRowSelected="HandleProductSelectedAsync" />
                </section>

                <section class="dashboard-section">
                    <h2>Recent Activity</h2>
                    <AdminActivityFeed Events="@ActivityEvents" OnRefresh="RefreshActivityAsync" />
                </section>

                <section class="dashboard-section admin-actions">
                    <h2>Administrator Actions</h2>
                    <div class="actions-grid">
                        <button class="action-btn" @onclick="HandleOnboardVendorAsync">
                            <i class="icon-plus" aria-hidden="true"></i>
                            <span>Onboard Vendor</span>
                        </button>
                        <button class="action-btn" @onclick="HandleAuditLogsAsync">
                            <i class="icon-log" aria-hidden="true"></i>
                            <span>View Audit Logs</span>
                        </button>
                        <button class="action-btn" @onclick="HandleComplianceReportAsync">
                            <i class="icon-report" aria-hidden="true"></i>
                            <span>Generate Report</span>
                        </button>
                        <button class="action-btn" @onclick="HandleSystemSettingsAsync">
                            <i class="icon-settings" aria-hidden="true"></i>
                            <span>System Settings</span>
                        </button>
                    </div>
                </section>
            </div>
        }
    </ChildContent>
</DashboardLayout>

@code {
    [Parameter]
    public string? TenantId { get; set; }

    private const string PageTitle = "Administrator Dashboard";

    private List<BreadcrumbItem> BreadcrumbItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private int VendorCount { get; set; }
    private int ProductCount { get; set; }
    private int OrderCount { get; set; }
    private int CategoryCount { get; set; }

    private IReadOnlyList<AdminVendorRow> Vendors { get; set; } = [];
    private IReadOnlyList<AdminProductRow> Products { get; set; } = [];
    private IReadOnlyList<ActivityEvent> ActivityEvents { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation(
                "Initializing admin dashboard for tenant {TenantId}",
                TenantContext.TenantId);

            BreadcrumbItems = await NavigationService.GetBreadcrumbsAsync(
                TenantContext,
                $"/tenant/{TenantContext.TenantId}/dashboard/admin");

            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing admin dashboard");
            ErrorMessage = "Failed to load the admin dashboard. Please refresh the page.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        var vendorsTask = Api.GetVendorsAsync();
        var productsTask = Api.GetProductsAsync(pageSize: 100);
        var ordersTask = Api.GetOrdersAsync();
        var categoriesTask = Api.GetCategoriesAsync();

        await Task.WhenAll(vendorsTask, productsTask, ordersTask, categoriesTask);

        var vendorRows = ProjectVendors(vendorsTask.Result);
        var productRows = ProjectProducts(productsTask.Result);
        var orderRows = ordersTask.Result;
        var categoryRows = categoriesTask.Result;

        Vendors = vendorRows;
        Products = productRows;
        ActivityEvents = BuildRecentActivity(vendorRows, productRows);

        VendorCount = vendorRows.Count;
        ProductCount = productRows.Count(p => !p.IsOutOfStock);
        OrderCount = orderRows.IsSuccess ? orderRows.Data?.Length ?? 0 : 0;
        CategoryCount = categoryRows.IsSuccess ? categoryRows.Data?.Length ?? 0 : 0;
    }

    private static IReadOnlyList<AdminVendorRow> ProjectVendors(ApiResult<VendorDto[]> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            return [];
        }

        return result.Data
            .Select(v => new AdminVendorRow(
                v.Id,
                v.Name,
                v.Country,
                v.Email,
                v.Status,
                string.Equals(v.Status, "Active", StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private static IReadOnlyList<AdminProductRow> ProjectProducts(ApiResult<ProductDto[]> result)
    {
        if (!result.IsSuccess || result.Data is null)
        {
            return [];
        }

        return result.Data
            .Select(p => new AdminProductRow(
                p.Id,
                p.Title,
                p.VendorName,
                p.Price,
                p.Currency,
                p.HalalStatus?.Status ?? "Unknown")
            {
                StatusCode = p.HalalStatus?.Status switch
                {
                    "Certified" => 0,
                    "VerifiedByPlatform" => 1,
                    "MuslimFriendly" => 2,
                    "NonCompliant" => 3,
                    _ => 4
                },
                IsOutOfStock = p.Inventory <= 0
            })
            .ToList();
    }

    private static IReadOnlyList<ActivityEvent> BuildRecentActivity(
        IReadOnlyList<AdminVendorRow> vendors,
        IReadOnlyList<AdminProductRow> products)
    {
        var now = DateTimeOffset.UtcNow;

        var events = vendors
            .Select(v => new ActivityEvent(
                $"{v.Name} {(v.IsVerified ? "verified" : "pending verification")}",
                v.CountryFilter,
                now,
                Category: "vendor"))
            .Concat(products
                .Select(p => new ActivityEvent(
                    $"{p.Title} catalogued",
                    p.VendorName,
                    now,
                    Category: "product")))
            .ToList();

        return events;
    }

    private async Task RefreshActivityAsync()
    {
        Logger.LogInformation("Refreshing admin activity feed");
        await LoadDashboardDataAsync();
    }

    private void HandleVendorSelectedAsync(AdminVendorRow vendor)
    {
        Logger.LogInformation("Vendor selected: {VendorId}", vendor.Id);
        Nav.NavigateTo($"/vendors/{vendor.Id}");
    }

    private void HandleProductSelectedAsync(AdminProductRow product)
    {
        Logger.LogInformation("Product selected: {ProductId}", product.Id);
        Nav.NavigateTo($"/products/{product.Id}");
    }

    private void HandleOnboardVendorAsync() => Nav.NavigateTo("/vendors");

    private void HandleAuditLogsAsync() => Nav.NavigateTo("/verify");

    private void HandleComplianceReportAsync()
        => Logger.LogInformation("Compliance report generation requested");

    private void HandleSystemSettingsAsync() => Nav.NavigateTo("/account");
}
