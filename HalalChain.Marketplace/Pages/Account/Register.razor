@page "/account/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject INotificationService Toast

<PageTitle>Create account</PageTitle>

<div class="auth-title">
    <h1>Create your account</h1>
    <p class="muted">Join HalalChain to shop verified products and track your orders.</p>
</div>

<EditForm Model="@_form" OnValidSubmit="@Submit">
    <DataAnnotationsValidator />
    <div class="stack gap-3">
        <div>
            <label class="small muted">Full name</label>
            <RadzenTextBox @bind-Value="_form.Name" Style="width:100%;" />
        </div>
        <div>
            <label class="small muted">Email</label>
            <RadzenTextBox @bind-Value="_form.Email" Style="width:100%;" />
        </div>
        <div>
            <label class="small muted">Password</label>
            <RadzenPassword @bind-Value="_form.Password" Style="width:100%;" />
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }
        <RadzenButton Text="Create account" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" ButtonType="ButtonType.Submit" IsBusy="@_submitting" Style="width:100%;" />
    </div>
</EditForm>

<div class="auth-foot">
    <span>Already have an account?</span>
    <a href="/account/login">Sign in</a>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private RegisterForm _form = new();
    private string? _error;
    private bool _submitting;

    public class RegisterForm
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private async Task Submit()
    {
        _submitting = true; _error = null;
        var result = await Auth.RegisterAsync(_form.Email, _form.Password, _form.Name);
        _submitting = false;
        if (result.IsSuccess && result.Data?.Token != null)
        {
            Toast.Success("Welcome to HalalChain!");
            Nav.NavigateTo(ReturnUrl ?? "/account", forceLoad: true);
        }
        else _error = "Registration failed. Please try a different email.";
    }
}
