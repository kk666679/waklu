@* Vendors marketplace listing page *@
@page "/vendors"
@using HalalChain.Marketplace.Models.ViewModels
@using HalalChain.Marketplace.Repositories
@inject IVendorRepository VendorRepo
@inject IProductRepository ProductRepo
@inject IMapper Mapper
@inject ILogger<IndexViewModel> Logger
@inject NavigationManager Nav

<PageTitle>Vendors</PageTitle>

<section class="container section-sm">
    <div style="margin-bottom: var(--space-5);">
        <p class="eyebrow">Marketplace</p>
        <h1 style="font-size: var(--text-2xl);">Browse Vendors</h1>
        <p class="muted">Discover trusted halal-verified vendors in our marketplace.</p>
    </div>

    @if (_isLoading)
    {
        <p class="muted">Loading vendors…</p>
    }
    else if (_vendors?.Length == 0)
    {
        <div class="panel card-pad" style="text-align:center;">
            <p style="font-size:var(--text-4xl); margin:0;">🏪</p>
            <h3 style="margin:var(--space-2) 0 0;">No vendors found</h3>
            <p class="muted">Check back soon for new vendors.</p>
        </div>
    }
    else
    {
        <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-4);">
            @foreach (var vendor in _vendors)
            {
                <a href="/vendors/@vendor.Slug" class="panel card-pad" style="text-decoration: none; color: inherit; transition: all 200ms;">
                    <div style="text-align: center; margin-bottom: var(--space-3);">
                        <div style="font-size: var(--text-3xl); margin-bottom: var(--space-2);">🏢</div>
                        <h3 style="margin: 0 0 var(--space-1);">@vendor.Name</h3>
                        <div class="row gap-1" style="justify-content: center; align-items: center;">
                            <span class="small muted">@vendor.ProductCount products</span>
                            @if (vendor.AverageRating > 0)
                            {
                                <span class="small muted">· ⭐ @vendor.AverageRating.ToString("N1")</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(vendor.Country))
                    {
                        <p class="small muted" style="text-align: center;">📍 @vendor.Country</p>
                    }

                    <div class="between" style="margin-top: var(--space-2);">
                        <span class="@GetStatusBadgeClass(vendor.Status)">@vendor.Status</span>
                        <span class="small muted">→</span>
                    </div>
                </a>
            }
        </div>

        @if (TotalPages > 1)
        {
            <nav class="row center gap-2" style="margin-top: var(--space-5);" aria-label="Pagination">
                <RadzenButton Text="← Previous" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                    Disabled="@(CurrentPage <= 1)" Click="@(() => GoToPage(CurrentPage - 1))" />
                <span class="small muted">Page @CurrentPage of @TotalPages</span>
                <RadzenButton Text="Next →" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                    Disabled="@(CurrentPage >= TotalPages)" Click="@(() => GoToPage(CurrentPage + 1))" />
            </nav>
        }
    }
</section>

@code {
    private VendorViewModel[]? _vendors;
    private int CurrentPage { get; set; } = 1;
    private int TotalPages { get; set; } = 1;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadVendors();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing vendors page");
        }
    }

    private async Task LoadVendors()
    {
        _isLoading = true;
        try
        {
            const int pageSize = 12;
            var skip = (CurrentPage - 1) * pageSize;

            // Get active vendors
            var vendors = await VendorRepo.GetActiveAsync(skip, pageSize);
            var vendorViewModels = Mapper.Map<VendorViewModel[]>(vendors.ToArray());

            // Enrich with product counts
            foreach (var vm in vendorViewModels)
            {
                var products = await ProductRepo.GetByVendorAsync(vm.Id, 0, int.MaxValue);
                vm.ProductCount = products.Count();
            }

            _vendors = vendorViewModels;

            // Calculate total pages
            var totalCount = await VendorRepo.GetActiveCountAsync();
            TotalPages = (int)Math.Ceiling(totalCount / (decimal)pageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading vendors");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            InvokeAsync(LoadVendors);
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "badge bg-success",
        "Pending" => "badge bg-warning",
        "Suspended" => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}
