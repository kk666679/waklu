@* Orders page updated to use repository layer *@
@page "/orders"
@using HalalChain.Marketplace.Models.ViewModels
@using HalalChain.Marketplace.Repositories
@inject IOrderRepository OrderRepo
@inject ICurrentUserAccessor CurrentUser
@inject IMapper Mapper
@inject ILogger<IndexViewModel> Logger
@inject NavigationManager Nav

<PageTitle>Your orders</PageTitle>

<section class="container section-sm">
    <h1 style="font-size: var(--text-2xl); margin-bottom: var(--space-5);">Your orders</h1>

    @if (CurrentUserId == Guid.Empty)
    {
        <div class="panel card-pad">
            <p style="text-align:center; font-size:var(--text-4xl); margin:0;">🔒</p>
            <h3 style="text-align:center; margin:var(--space-2) 0 0;">Sign in to view orders</h3>
            <p class="muted" style="text-align:center;">Access your order history and track shipments.</p>
            <a class="btn btn-primary" href="/account/login?returnUrl=/orders" style="display:block; margin-top:var(--space-3);">Sign in</a>
        </div>
    }
    else if (_isLoading)
    {
        <p class="muted">Loading orders…</p>
    }
    else if (Orders.Length == 0)
    {
        <div class="panel card-pad">
            <p style="text-align:center; font-size:var(--text-4xl); margin:0;">📦</p>
            <h3 style="text-align:center; margin:var(--space-2) 0 0;">No orders yet</h3>
            <p class="muted" style="text-align:center;">Start shopping to place your first order.</p>
            <a class="btn btn-primary" href="/browse" style="display:block; margin-top:var(--space-3);">Start shopping</a>
        </div>
    }
    else
    {
        <div class="stack gap-3">
            @foreach (var order in Orders)
            {
                <div class="panel card-pad">
                    <div class="between" style="margin-bottom: var(--space-3); align-items:start;">
                        <div>
                            <div class="eyebrow">Order #@order.Id.ToString().Substring(0, 8)</div>
                            <h3 style="margin:var(--space-1) 0 0;">@order.DisplayDate</h3>
                            <p class="small muted">@order.ItemCount item@(order.ItemCount == 1 ? "" : "s")</p>
                        </div>
                        <div style="text-align:right;">
                            <span class="@order.StatusBadgeClass">@order.Status</span>
                            <p class="eyebrow" style="margin-top:var(--space-2);">@order.Currency @order.Total.ToString("N2")</p>
                        </div>
                    </div>

                    <a class="btn btn-secondary btn-sm" href="/orders/@order.Id">View details</a>
                </div>
            }
        </div>

        @if (TotalPages > 1)
        {
            <nav class="row center gap-2" style="margin-top: var(--space-5);" aria-label="Pagination">
                <RadzenButton Text="← Previous" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                    Disabled="@(CurrentPage <= 1)" Click="@(() => GoToPage(CurrentPage - 1))" />
                <span class="small muted">Page @CurrentPage of @TotalPages</span>
                <RadzenButton Text="Next →" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                    Disabled="@(CurrentPage >= TotalPages)" Click="@(() => GoToPage(CurrentPage + 1))" />
            </nav>
        }
    }
</section>

@code {
    private Guid CurrentUserId { get; set; }
    private OrderHistoryViewModel[] Orders = [];
    private int CurrentPage { get; set; } = 1;
    private int TotalPages { get; set; } = 1;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentUserId = await CurrentUser.GetIdAsync();
            if (CurrentUserId != Guid.Empty)
            {
                await LoadOrders();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing orders page");
        }
    }

    private async Task LoadOrders()
    {
        _isLoading = true;
        try
        {
            const int pageSize = 10;
            var skip = (CurrentPage - 1) * pageSize;

            var orders = await OrderRepo.GetByCustomerAsync(CurrentUserId, skip, pageSize);
            Orders = orders.Select(o => new OrderHistoryViewModel
            {
                Id = o.Id,
                Status = o.Status,
                Total = o.Total,
                Currency = o.Currency,
                ItemCount = o.VendorOrders?.Sum(vo => vo.Items?.Sum(oi => oi.Quantity) ?? 0) ?? 0,
                CreatedAt = o.CreatedAt
            }).ToArray();

            // Calculate total pages
            var totalCount = await OrderRepo.GetCountAsync();
            TotalPages = (int)Math.Ceiling(totalCount / (decimal)pageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading orders for customer: {CustomerId}", CurrentUserId);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            InvokeAsync(LoadOrders);
        }
    }
}
