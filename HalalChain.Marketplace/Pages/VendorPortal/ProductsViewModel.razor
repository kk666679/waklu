@* Vendor product management page with repository integration *@
@page "/vendor/products"
@using HalalChain.Marketplace.Models.ViewModels
@using HalalChain.Marketplace.Repositories
@inject IProductRepository ProductRepo
@inject ICurrentUserAccessor CurrentUser
@inject IMapper Mapper
@inject ILogger<ProductsViewModel> Logger
@inject NavigationManager Nav
@inject INotificationService Toast

<PageTitle>Manage Products</PageTitle>

@if (_isLoading)
{
    <section class="container section-sm">
        <p class="muted">Loading products…</p>
    </section>
}
else if (!_isAuthenticated)
{
    <section class="container section-sm">
        <div class="panel card-pad">
            <p style="text-align:center; font-size:var(--text-4xl); margin:0;">🔒</p>
            <h3 style="text-align:center; margin:var(--space-2) 0 0;">Sign in required</h3>
            <a class="btn btn-primary" href="/account/login?returnUrl=/vendor/products" style="display:block; margin-top:var(--space-3); text-align:center;">Sign in to manage products</a>
        </div>
    </section>
}
else
{
    <section class="container section-sm">
        <div class="between" style="margin-bottom: var(--space-5); align-items: center; gap: var(--space-3);">
            <div>
                <p class="eyebrow">Catalog</p>
                <h1 style="font-size: var(--text-2xl); margin: 4px 0 0;">Manage Products</h1>
            </div>
            <a class="btn btn-primary" href="/vendor/products/new">+ New product</a>
        </div>

        @* Filters and Search *@
        <div class="panel card-pad" style="margin-bottom: var(--space-4);">
            <div class="grid" style="grid-template-columns: 1fr 1fr 1fr auto; gap: var(--space-2); align-items: end;">
                <div>
                    <label class="small" style="display: block; margin-bottom: 4px; font-weight: 600;">Search</label>
                    <input type="text" placeholder="Search products…" 
                        value="@_searchQuery" 
                        @onchange="@((ChangeEventArgs e) => { _searchQuery = e.Value?.ToString() ?? ""; ApplyFilters(); })"
                        style="width: 100%; padding: 8px; border: 1px solid var(--color-border); border-radius: 4px;" />
                </div>

                <div>
                    <label class="small" style="display: block; margin-bottom: 4px; font-weight: 600;">Status</label>
                    <select value="@_statusFilter" @onchange="ApplyFilters" style="width: 100%; padding: 8px; border: 1px solid var(--color-border); border-radius: 4px;">
                        <option value="">All statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Draft">Draft</option>
                    </select>
                </div>

                <div>
                    <label class="small" style="display: block; margin-bottom: 4px; font-weight: 600;">Halal Status</label>
                    <select value="@_halalStatusFilter" @onchange="ApplyFilters" style="width: 100%; padding: 8px; border: 1px solid var(--color-border); border-radius: 4px;">
                        <option value="">All</option>
                        <option value="Certified">Certified</option>
                        <option value="Verified">Verified</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>

                <button class="btn btn-secondary" @onclick="ResetFilters">Clear filters</button>
            </div>
        </div>

        @if (_products?.Length == 0)
        {
            <div class="panel card-pad" style="text-align:center;">
                <p style="font-size:var(--text-4xl); margin:0;">📦</p>
                <h3 style="margin:var(--space-2) 0 0;">No products yet</h3>
                <p class="muted">Start selling by creating your first product.</p>
                <a class="btn btn-primary" href="/vendor/products/new" style="margin-top:var(--space-2);">Create product</a>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--color-border);">
                            <th style="text-align: left; padding: var(--space-2); font-weight: 600;">Product</th>
                            <th style="text-align: center; padding: var(--space-2); font-weight: 600;">Price</th>
                            <th style="text-align: center; padding: var(--space-2); font-weight: 600;">Stock</th>
                            <th style="text-align: center; padding: var(--space-2); font-weight: 600;">Halal Status</th>
                            <th style="text-align: center; padding: var(--space-2); font-weight: 600;">Status</th>
                            <th style="text-align: center; padding: var(--space-2); font-weight: 600;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in _products)
                        {
                            <tr style="border-bottom: 1px solid var(--color-border);">
                                <td style="padding: var(--space-2);">
                                    <div>
                                        <a href="/products/@product.Id" style="font-weight: 600; color: var(--color-link);">@product.Title</a>
                                        <p class="small muted" style="margin: 4px 0 0;">@product.Sku</p>
                                    </div>
                                </td>
                                <td style="text-align: center; padding: var(--space-2);">
                                    @product.Currency @product.Price.ToString("N2")
                                </td>
                                <td style="text-align: center; padding: var(--space-2);">
                                    <span style="@(product.IsOutOfStock ? "color: var(--color-danger);" : "")">
                                        @product.Inventory
                                    </span>
                                </td>
                                <td style="text-align: center; padding: var(--space-2);">
                                    @if (string.IsNullOrEmpty(product.HalalStatus))
                                    {
                                        <span class="badge badge-secondary">Not set</span>
                                    }
                                    else
                                    {
                                        <span class="@GetHalalStatusClass(product.HalalStatus)">@product.HalalStatus</span>
                                    }
                                </td>
                                <td style="text-align: center; padding: var(--space-2);">
                                    <span class="@GetStatusBadgeClass(product)">@GetStatusDisplay(product)</span>
                                </td>
                                <td style="text-align: center; padding: var(--space-2);">
                                    <div class="row gap-1" style="justify-content: center; flex-wrap: wrap;">
                                        <a class="btn btn-ghost btn-sm" href="/vendor/products/@product.Id/edit" title="Edit">✎</a>
                                        <a class="btn btn-ghost btn-sm" href="/products/@product.Id" title="View">👁</a>
                                        <button class="btn btn-ghost btn-sm" @onclick="@(() => DeleteProduct(product.Id))" title="Delete">🗑</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (TotalPages > 1)
            {
                <nav class="row center gap-2" style="margin-top: var(--space-5);" aria-label="Pagination">
                    <RadzenButton Text="← Previous" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                        Disabled="@(CurrentPage <= 1)" Click="@(() => GoToPage(CurrentPage - 1))" />
                    <span class="small muted">Page @CurrentPage of @TotalPages</span>
                    <RadzenButton Text="Next →" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" 
                        Disabled="@(CurrentPage >= TotalPages)" Click="@(() => GoToPage(CurrentPage + 1))" />
                </nav>
            }

            <div class="small muted" style="margin-top: var(--space-4); text-align: center;">
                Showing @_products.Length of @_totalCount products
            </div>
        }
    </section>
}

@code {
    private ProductViewModel[]? _products;
    private int _totalCount = 0;
    private int CurrentPage { get; set; } = 1;
    private int TotalPages { get; set; } = 1;
    private const int PageSize = 20;

    private string _searchQuery = string.Empty;
    private string _statusFilter = string.Empty;
    private string _halalStatusFilter = string.Empty;
    private bool _isAuthenticated = false;
    private bool _isLoading = true;
    private Guid VendorId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            VendorId = await CurrentUser.GetIdAsync();
            _isAuthenticated = VendorId != Guid.Empty;

            if (_isAuthenticated)
            {
                await LoadProducts();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing product management page");
            Toast.Error("Failed to load products");
        }
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        try
        {
            const int pageSize = PageSize;
            var skip = (CurrentPage - 1) * pageSize;

            // Get products for vendor
            var products = await ProductRepo.GetByVendorAsync(VendorId, skip, pageSize);
            
            // Apply filters
            var filtered = products.AsEnumerable();

            if (!string.IsNullOrEmpty(_searchQuery))
            {
                filtered = filtered.Where(p => 
                    p.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Sku.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            // Map to ViewModels
            _products = Mapper.Map<ProductViewModel[]>(filtered.ToArray());

            // Get total count for pagination
            var allProducts = await ProductRepo.GetByVendorAsync(VendorId);
            _totalCount = allProducts.Count();
            TotalPages = (int)Math.Ceiling(_totalCount / (decimal)pageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading vendor products");
            Toast.Error("Failed to load products");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 1;
        await LoadProducts();
    }

    private async Task ResetFilters()
    {
        _searchQuery = string.Empty;
        _statusFilter = string.Empty;
        _halalStatusFilter = string.Empty;
        CurrentPage = 1;
        await LoadProducts();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            InvokeAsync(LoadProducts);
        }
    }

    private async Task DeleteProduct(Guid productId)
    {
        if (!await Toast.Confirm("Delete this product? This action cannot be undone."))
        {
            return;
        }

        try
        {
            // TODO: Implement product deletion via repository
            Toast.Success("Product deleted");
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting product");
            Toast.Error("Failed to delete product");
        }
    }

    private string GetStatusBadgeClass(ProductViewModel product) => product switch
    {
        _ when product.IsOutOfStock => "badge badge-warning",
        _ => "badge badge-success"
    };

    private string GetStatusDisplay(ProductViewModel product) => product switch
    {
        _ when product.IsOutOfStock => "Out of stock",
        _ => "Active"
    };

    private string GetHalalStatusClass(string status) => status switch
    {
        "Certified" => "badge badge-success",
        "Verified" => "badge badge-info",
        "Pending" => "badge badge-warning",
        _ => "badge badge-secondary"
    };
}
