{
  "Dashboard": {
    "DefaultCacheDurationSeconds": 60,
    "EnableDistributedCache": false,
    "EnableRuntimeCache": true,
    "Theme": "light",
    "PrimaryColor": "#0066CC",
    "Caching": {
      "UseDistributedCache": false,
      "UseInMemoryCache": true,
      "CacheTtlSeconds": 60,
      "WarmUpOnStartup": false,
      "InvalidateOnConfigChange": true
    },
    "Storage": {
      "UseDatabase": true,
      "UseFileSystem": true,
      "FileStoragePath": "./dashboard-configs-dev",
      "ArchiveOldVersions": false
    },
    "FeatureFlags": {
      "enable_audit_tab": true,
      "show_compliance_dashboard": true,
      "enable_vendor_analytics": true,
      "enable_real_time_updates": false,
      "enable_widget_customization": true,
      "enable_advanced_filtering": true,
      "enable_export_data": true
    }
  }
}
