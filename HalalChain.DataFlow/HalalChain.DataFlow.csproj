<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HalalChain.DataFlow</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Polly" Version="8.5.2" />
  </ItemGroup>

  <!--
    Deliberately references Domain + Contracts only. DataFlow is a leaf
    integration library: it must not drag in the API host, UI, or MCP, and
    it does not need Application abstractions. It also keeps this project
    independently buildable while the Domain refactor is in flight.
  -->
  <ItemGroup>
    <ProjectReference Include="..\HalalChain.Domain\HalalChain.Domain.csproj" />
    <ProjectReference Include="..\HalalChain.Platform.Contracts\HalalChain.Platform.Contracts.csproj" />
  </ItemGroup>

</Project>