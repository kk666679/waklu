<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!--
    NetArchTest inspects compiled assemblies. We reference the projects
    we need to inspect so they are loaded into the test host. We do not
    depend on these projects at runtime — the references are only there
    to make the test host load the assemblies.
  -->
  <ItemGroup>
    <ProjectReference Include="..\HalalChain.Domain\HalalChain.Domain.csproj" />
    <ProjectReference Include="..\HalalChain.Platform.Contracts\HalalChain.Platform.Contracts.csproj" />
    <ProjectReference Include="..\HalalChain.Platform.Http\HalalChain.Platform.Http.csproj" />
    <ProjectReference Include="..\HalalChain.Platform.Api\HalalChain.Platform.Api.csproj" />
    <ProjectReference Include="..\HalalChain.Mcp\HalalChain.Mcp.csproj" />
    <ProjectReference Include="..\HalalChain.Marketplace\HalalChain.Marketplace.csproj" />
    <ProjectReference Include="..\HalalChain.Web\HalalChain.Web.csproj" />
  </ItemGroup>

</Project>
