# ── Mode ──────────────────────────────────────────────────────────────────
DEMO_MODE=true
ENVIRONMENT=development

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://tawheed:tawheed@localhost:5432/tawheed

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=halal_knowledge

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tawheed123

# ── LLM (optional — system degrades gracefully without it) ────────────────
# AI is used ONLY for document interpretation — never for compliance decisions.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ── ONNX models ────────────────────────────────────────────────────────────
ONNX_MODEL_DIR=models/onnx

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-minimum-32-chars-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Observability ──────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ── Policy ─────────────────────────────────────────────────────────────────
DEFAULT_POLICY_VERSION=MY-v3
DEFAULT_JURISDICTION=MY

# ── Risk thresholds ────────────────────────────────────────────────────────
RISK_THRESHOLD_MANUAL_REVIEW=0.65
RISK_THRESHOLD_HOLD=0.85
